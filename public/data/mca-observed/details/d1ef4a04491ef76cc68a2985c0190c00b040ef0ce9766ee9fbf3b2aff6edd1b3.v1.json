7500+00:00"},"warning":null},{"key":"listedMonthlyFeeMax","label":"月费用上限（平台列示）","text":"4,800 元/月","state":"observed","source":{"channelLabel":"基本详情","fetchedAtUtc":"2026-11-19T11:46:36.587500+00:00"},"warning":null},{"key":"platformStarCode","label":"机构星级原码（评定期未核）","text":"00","state":"observed","source":{"channelLabel":"平台列表","fetchedAtUtc":"2026-11-19T08:34:17.587474+00:00"},"warning":null},{"key":"evaluationCount","label":"平台评价次数","text":"0 次","state":"observed","source":{"channelLabel":"基本详情","fetchedAtUtc":"2026-11-19T11:46:36.587500+00:00"},"warning":null},{"key":"overallEvaluation","label":"平台综合评价原值","text":"暂无评价（原值为 0）","state":"observed","source":{"channelLabel":"基本详情","fetchedAtUtc":"2026-11-19T11:46:36.587500+00:00"},"warning":null},{"key":"functionPositioningLabel","label":"功能定位原标签","text":"原平台未提供","state":"missing","source":null,"warning":null},{"key":"platformTagsRaw","label":"平台标签原文（资格未核）","text":"民办,长护险定点机构,医养结合养老机构,与医疗机构签约合作,农村","state":"observed","source":{"channelLabel":"基本详情","fetchedAtUtc":"2026-11-19T11:46:36.587500+00:00"},"warning":null}],"platformDetail":{"identity":{"facilityType":{"state":"observed","value":"养老机构","observationCount":1},"starCode":{"state":"observed","value":"00","observationCount":1},"functionPositioning":{"state":"missing","value":null,"observationCount":0},"region":{"state":"observed","value":"天津市/滨海新区","observationCount":1},"address":{"state":"observed","value":"天津市滨海新区大港海滨街沙井子一村穿港公路北","observationCount":1}},"tags":{"state":"observed","value":["民办","长护险定点机构","医养结合养老机构","与医疗机构签约合作","农村"],"observationCount":1},"subsidyCode":{"state":"observed","value":"1","observationCount":1},"contactName":{"state":"observed","value":"白浩良","observationCount":1},"contactPhone":{"state":"observed","value":"13332007179","observationCount":1},"pointRaw":{"state":"observed","value":"117.3563,38.67582","observationCount":1},"photoCount":{"state":"observed","value":5,"observationCount":1},"areaSqm":{"state":"observed","value":4957,"observationCount":1},"introduction":{"state":"observed","value":"天津市滨海新区海滨街道综合养老服务中心（运营实体：天津市滨海新区鑫诚老年养护院），是经滨海新区民政局核准设立的民办非企业单位（统一社会信用代码：52120116MJ0631151E），为合规备案的街道级综合养老服务机构。中心经营面积4957.06㎡，核定床位165张（护理床位100张），配备持证养老护理员、康复师等专业团队，擅长中度及以上失能老人照护与康复，服务覆盖机构住养、日间托养及居家上门，可提供助餐助浴助洁、康复护理等适配消费券补贴的服务，已完成消防验收及机构备案，建立消费券专项管理机制，确保惠民政策精准落地。","observationCount":1},"service":{"content":{"state":"observed","value":"• 机构住养：1800-4800元/月，含护理床位、膳食、护理费用，按失能等级计费； • 短期托养（喘息服务）：160-320元/天，临时托养+基础护理+膳食，不足1天按1天算； • 日间托养：60-120元/天，日间照料+康复训练+膳食，分级适配需求； • 居家上门：天津全域覆盖，基础服务80元/小时（含助浴、助餐、家政等基础照料），专业康复护理150元/小时。具体按实际服务项目及时长计费； • 增值服务：配餐送餐、精神慰藉、文化娱乐、心理咨询，全面满足生活与精神需求。","observationCount":1},"team":{"state":"observed","value":"团队配置充足且专业，核心服务人员均持证上岗，其中持证养老护理员含高级工、四级、五级等不同等级，均通过正规职业技能等级认定，实操经验扎实。另配备康复师、评估师、心理咨询师等专项人才，资质齐全。团队定期开展服务规范、沟通技巧、专业照护等专项培训，严格遵守养老服务相关法规政策，秉持耐心、细心、贴心的服务准则，既擅长失能老人专业护理、康复训练等核心服务，也注重人文关怀与沟通适配，全方位保障老年人照护质量与生活体验。","observationCount":1},"hours":{"state":"observed","value":"• 机构住养：24小时全日制照护，全年无休； • 居家上门：8:00-18:00（可按需调整预约时间）； • 咨询预约：工作日8:30-17:30，节假日支持电话提前预约，24小时内反馈确认。","observationCount":1},"scope":{"state":"observed","value":"• 机构入住：核心覆盖滨海新区海滨街道，面向全国接收符合条件的老年人； • 上门服务：辐射天津市全域，天津市内中度及以上失能老年人，均可预约居家护理、助餐、家政等服务，实现“就近便捷、全域覆盖”。","observationCount":1},"explanation":{"state":"observed","value":"1. 服务对象：自理、半自理、中度及以上失能老年人，含残疾人、生活困难人群； 2. 收费透明：明码标价，无临时涨价、隐形消费，按照护等级、服务天数/时长核算； 3. 预约方式：支持全国养老服务信息平台、民政通在线预约，或电话咨询，预约后24小时内确认； 4. 服务保障：签订正式服务协议，明确权责与风险处置，严格保护个人信息，接受民政部门及社会监督； 5. 补贴适配：服务项目符合中度以上失能老年人消费补贴要求，可凭电子消费券核销，核销规则按官方政策执行。","observationCount":1}},"beds":{"total":{"state":"observed","value":165,"observationCount":1},"dayCare":{"state":"observed","value":65,"observationCount":1},"fullCare":{"state":"observed","value":100,"observationCount":1},"nursing":{"state":"observed","value":100,"observationCount":1}},"feeSummary":[{"code":"04","label":"月总费用","range":{"state":"observed","value":[1800,4800],"observationCount":1},"description":{"state":"observed","value":"为护理费、床位费、膳食费等各项服务费用的合计金额，具体以实际入住服务项目及对应收费标准为准。","observationCount":1}},{"code":"02","label":"床位费用","range":{"state":"observed","value":[700,1400],"observationCount":1},"description":{"state":"observed","value":"包含养老机构床位使用、房间基础配套设施（床具、衣柜、空调等）维护及公共区域保洁等费用，按房型及设施配置收取。","observationCount":1}},{"code":"01","label":"护理费用","range":{"state":"observed","value":[500,2500],"observationCount":1},"description":{"state":"observed","value":"据老人护理等级（如自理、半失能、失能、失智）提供对应的生活照料、基础护理及康复辅助服务，具体根据护理强度和服务内容确定。","observationCount":1}},{"code":"03","label":"膳食费用","range":{"state":"observed","value":[600,900],"observationCount":1},"description":{"state":"observed","value":"为老人提供一日三餐及必要加餐，根据营养需求搭配膳食，包含食材采购、烹饪、分餐等成本，按月结算。","observationCount":1}}],"charges":{"state":"observed","value":[{"id":"bd38191cf5fe471e92b42af8f7886d83","name":"一级护理收费","description":"本项目为综合打包收费，包含床位费、护理费、餐饮费。服务对象为生活完全自理老人，提供标准居住房间、日常房间及公共区域保洁、定时安全巡查、基础生活协助、一日三餐营养膳食等服务。","standard":"1800-2200元/人/月（根据居住房型及服务需求浮动）"},{"id":"66c6ab98017f4436bf36a4ebe0600e69","name":"二级护理收费","description":"本项目为综合打包收费，包含床位费、护理费、餐饮费。服务对象为半自理、轻度失能老人，在一级护理基础上，增加协助进食、洗漱、穿衣、如厕、简单康复指导、定时巡视照料等服务。","standard":"2500-2800元/人/月（根据护理需求及服务内容浮动）"},{"id":"8b60dd4cd8b044deb420e113dfe6d97e","name":"三级护理收费","description":"本项目为综合打包收费，包含床位费、护理费、餐饮费。服务对象为完全失能老人，提供24小时专人照料，含喂饭、擦浴、大小便护理、定时翻身、压疮预防、生命体征监测、居住及一日三餐营养膳食等综合服务。","standard":"3500-3800元/人/月（根据护理强度及个性化需求浮动）"}],"observationCount":1},"evaluation":{"state":"observed","text":"暂无平台评价","count":{"state":"observed","value":0,"observationCount":1},"score":{"state":"observed","value":0,"observationCount":1}}},"conflictLabels":[],"detailObservedAtUtc":{"earliest":"2026-11-19T11:46:36.587500+00:00","latest":"2026-11-19T11:47:42.371029+00:00"}}

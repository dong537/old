ing":null},{"key":"listedMonthlyFeeMax","label":"月费用上限（平台列示）","text":"4,700 元/月","state":"observed","source":{"channelLabel":"基本详情","fetchedAtUtc":"2026-11-18T18:14:12.235311+00:00"},"warning":null},{"key":"platformStarCode","label":"机构星级原码（评定期未核）","text":"00","state":"observed","source":{"channelLabel":"平台列表","fetchedAtUtc":"2026-11-18T18:06:20.372025+00:00"},"warning":null},{"key":"evaluationCount","label":"平台评价次数","text":"0 次","state":"observed","source":{"channelLabel":"基本详情","fetchedAtUtc":"2026-11-18T18:14:12.235311+00:00"},"warning":null},{"key":"overallEvaluation","label":"平台综合评价原值","text":"暂无评价（原值为 0）","state":"observed","source":{"channelLabel":"基本详情","fetchedAtUtc":"2026-11-18T18:14:12.235311+00:00"},"warning":null},{"key":"functionPositioningLabel","label":"功能定位原标签","text":"原平台未提供","state":"missing","source":null,"warning":null},{"key":"platformTagsRaw","label":"平台标签原文（资格未核）","text":"民办,长护险定点机构,医养结合养老机构,与医疗机构签约合作,郊区","state":"observed","source":{"channelLabel":"基本详情","fetchedAtUtc":"2026-11-18T18:14:12.235311+00:00"},"warning":null}],"platformDetail":{"identity":{"facilityType":{"state":"observed","value":"养老机构","observationCount":2},"starCode":{"state":"observed","value":"00","observationCount":2},"functionPositioning":{"state":"missing","value":null,"observationCount":0},"region":{"state":"observed","value":"河南省/开封市/杞县","observationCount":2},"address":{"state":"observed","value":"东关转盘东300米路北","observationCount":2}},"tags":{"state":"observed","value":["民办","长护险定点机构","医养结合养老机构","与医疗机构签约合作","郊区"],"observationCount":1},"subsidyCode":{"state":"observed","value":"1","observationCount":1},"contactName":{"state":"observed","value":"张培变","observationCount":1},"contactPhone":{"state":"observed","value":"13393823236","observationCount":1},"pointRaw":{"state":"observed","value":"114.80111,34.54592","observationCount":1},"photoCount":{"state":"observed","value":9,"observationCount":1},"areaSqm":{"state":"observed","value":4500,"observationCount":1},"introduction":{"state":"observed","value":"康馨老年公寓是经民政局批复的一所养老福利服务机构，总面积为18亩。项目筹建于2014年3月份，投资金额960万，设立床位180张，主要建设内容为：老人住宿区域9栋，办公楼一栋，建有大型餐厅、多功能厅，健身广场及道路绿化等。 康馨老年公寓建成的11年以来，以专业化、规范化的管理及亲情化的服务赢得了社会各界人士及老人家属的好评，截止目前已经接收服务长期入住老人769人次，流动入住老人900多人次，长护险失能护理型床位94张，失能半失能人员占比40%，低保贫困五保老人45人，安置当地就业人员29人，曾获得上级部门颁发的奖牌9个，员工获得荣誉证书19个，并得到家属及老人赠送107面锦旗和牌匾，民政局及消防部门曾组织我县三十多家养老院负责人来我公寓开现场会，参观学习康馨的创新经营管理经验。经营11年的时间内从未出现过任何安全事故责任，获得了老人及家属的高度认可，在杞县养老市场需求已经具有很大的影响力。","observationCount":1},"service":{"content":{"state":"observed","value":"提供机构全托、日间照料等专业养老服务，覆盖自理、半失能、失能全人群。依托医养结合模式，将生活照料（助餐、助浴、助洁、助行）、基础照护（助医、排泄护理、康复训练）、健康管理（常规生理指数监测、失能等级评估）、精神慰藉（心理陪伴、文娱活动）与医疗保障深度融合，为老人提供健康监测、疾病预防及应急医疗响应，满足不同护理等级老人的全方位需求。","observationCount":1},"team":{"state":"observed","value":"拥有一支由优秀管理团队+专业护理团队组成的高素质服务队伍。 • 管理核心：由荣获市县两级表彰、拥有丰富养老行业管理经验的院长领衔，为机构运营与服务质量提供坚实保障。 • 护理团队：所有护理员均经系统培训并持证上岗，在半失能/失能老人照护方面经验丰富，按规范的配比为半失能/失能老人提供精细化照护，为自理老人提供精准服务，保障照护安全与品质。","observationCount":1},"hours":{"state":"observed","value":"全年无休，实行24小时在岗值守制。 • 日间服务：提供生活照料、健康监测、康复训练、精神慰藉等全流程服务。 • 夜间值守：护理员驻院值守，每晚进行夜间巡查，关注老人身体状况与安全，同时提供应急响应与基础照护支持。","observationCount":1},"scope":{"state":"observed","value":"专注于机构养老服务，接收杞县及周边区域的自理、半失能、失能老人。依托医养结合模式，将专业医疗服务与养老照护深度融合，为老人提供健康监测、疾病预防、康复护理及应急医疗响应等服务，满足全年龄段、全护理等级老人的养老需求。","observationCount":1},"explanation":{"state":"observed","value":"本机构采用“按护理等级打包收费”模式，收费包含床位费、膳食费、护理费及所有基础服务项目。我们以“专业照护、温暖陪伴”为宗旨，为老人提供安全、舒适、有尊严的养老生活。","observationCount":1}},"beds":{"total":{"state":"observed","value":200,"observationCount":1},"dayCare":{"state":"observed","value":0,"observationCount":1},"fullCare":{"state":"observed","value":200,"observationCount":1},"nursing":{"state":"observed","value":140,"observationCount":1}},"feeSummary":[{"code":"04","label":"月总费用","range":{"state":"observed","value":[1300,4700],"observationCount":1},"description":{"state":"observed","value":"为护理费、床位费及膳食费的合计费用，覆盖从自理到特护失能老人的全部收费标准。","observationCount":1}},{"code":"02","label":"床位费用","range":{"state":"observed","value":[600,1100],"observationCount":1},"description":{"state":"observed","value":"根据房型收取，最低为标准间床位费，最高为单间床位费。","observationCount":1}},{"code":"01","label":"护理费用","range":{"state":"observed","value":[300,3200],"observationCount":1},"description":{"state":"observed","value":"根据老人护理等级收取，最低为自理老人基础服务费，最高为特护失能（含气切、压疮、鼻饲等）老人专项护理费。如需专属一对一陪护，费用另行收取","observationCount":1}},{"code":"03","label":"膳食费用","range":{"state":"observed","value":[400,400],"observationCount":1},"description":{"state":"observed","value":"统一包含一日三餐及基础加餐费用，为固定收费。","observationCount":1}}],"charges":{"state":"observed","value":[],"observationCount":1},"evaluation":{"state":"observed","text":"暂无平台评价","count":{"state":"observed","value":0,"observationCount":2},"score":{"state":"observed","value":0,"observationCount":2}}},"conflictLabels":[],"detailObservedAtUtc":{"earliest":"2026-11-18T18:14:12.235311+00:00","latest":"2026-11-18T18:14:26.581789+00:00"}}

,"warning":null},{"key":"listedMonthlyFeeMax","label":"月费用上限（平台列示）","text":"15,800 元/月","state":"observed","source":{"channelLabel":"基本详情","fetchedAtUtc":"2026-11-20T06:28:16.781142+00:00"},"warning":null},{"key":"platformStarCode","label":"机构星级原码（评定期未核）","text":"00","state":"observed","source":{"channelLabel":"平台列表","fetchedAtUtc":"2026-11-19T21:06:10.682325+00:00"},"warning":null},{"key":"evaluationCount","label":"平台评价次数","text":"1 次","state":"observed","source":{"channelLabel":"基本详情","fetchedAtUtc":"2026-11-20T06:28:16.781142+00:00"},"warning":null},{"key":"overallEvaluation","label":"平台综合评价原值","text":"4.5（量表未核）","state":"observed","source":{"channelLabel":"基本详情","fetchedAtUtc":"2026-11-20T06:28:16.781142+00:00"},"warning":null},{"key":"functionPositioningLabel","label":"功能定位原标签","text":"原平台未提供","state":"missing","source":null,"warning":null},{"key":"platformTagsRaw","label":"平台标签原文（资格未核）","text":"民办,医养结合养老机构,与医疗机构签约合作,内设医疗机构,城区","state":"observed","source":{"channelLabel":"基本详情","fetchedAtUtc":"2026-11-20T06:28:16.781142+00:00"},"warning":null}],"platformDetail":{"identity":{"facilityType":{"state":"observed","value":"养老机构","observationCount":1},"starCode":{"state":"observed","value":"00","observationCount":1},"functionPositioning":{"state":"missing","value":null,"observationCount":0},"region":{"state":"observed","value":"福建省/厦门市/思明区","observationCount":1},"address":{"state":"observed","value":"厦门市思明区龙山东二路15号","observationCount":1}},"tags":{"state":"observed","value":["民办","医养结合养老机构","与医疗机构签约合作","内设医疗机构","城区"],"observationCount":1},"subsidyCode":{"state":"observed","value":"1","observationCount":1},"contactName":{"state":"observed","value":"吴燕燕","observationCount":1},"contactPhone":{"state":"observed","value":"15759277906","observationCount":1},"pointRaw":{"state":"observed","value":"118.14271,24.48177","observationCount":1},"photoCount":{"state":"observed","value":4,"observationCount":1},"areaSqm":{"state":"observed","value":1820,"observationCount":1},"introduction":{"state":"observed","value":"厦门莲花爱心护理院于2002年8月成立，坐落于思明区龙山东二路15号，依托厦门莲花医院创新“医养结合”模式，构建“医疗、养老、护理、康复、社工”五位一体服务体系，为失能失智、高龄空巢、重度残疾及临终关怀等群体，提供预防保健、生活照料、住院治疗、康复护理、安宁疗护的全流程服务。 护理院设200张床位，配备医务室、康复室等功能空间，房间内电视、空调、紧急呼叫等设施齐全；通过医生、康复师、护理员等多岗位一体化协作，满足老人医疗康复与生活照料双重需求。 自成立以来，护理院累计收住老人近4000人次，平均年龄85.6岁，最高龄113岁，楼下医院，楼上养老院，为入住老年人提供适宜的预防期保健、稳定期生活照料、患病期住院治疗、康复期护理服务以及临终期安宁疗护一体化医养服务；先后斩获全国医养结合示范机构、国家重点研发计划老年安宁疗护服务示范基地等多项国家级荣誉，还获评福建省级五星级养老机构、艾力彼全国医养结合机构第三名等称号，行业口碑与专业实力兼具。","observationCount":1},"service":{"content":{"state":"observed","value":"1、机构配备专业的医务人员和护理团队，处处体现对入住老人生命权及人格尊严的尊重，重点收住高龄老人、半护理、全护理、临终关怀老人及残疾老人，提供医疗、养老、康复、社工等保障服务。 2、建立老年科评估制度、慢病管理服务流程、急诊救护服务等制度流程。 3、提供床边康复、床边检查、治疗等，医院医疗资源多学科保障老年医疗安全。 4、提供饮食照护，清洁照护、排泄护理、睡眠护理、移动照 护等照料服务。 5、提供生命体征监测，口腔护理、鼻饲、吸痰、气切护理、压疮护理、心电监护、静脉输液等长期住养照护服务。","observationCount":1},"team":{"state":"observed","value":"行政后勤、医生、护士、社工、护理员、营养师、心理师、厨师、保安、消控员、卫生员","observationCount":1},"hours":{"state":"observed","value":"全年24小时连续提供医养康护社五位一体服务","observationCount":1},"scope":{"state":"observed","value":"养护、医疗康复、托管、预防保健、中医内科等","observationCount":1},"explanation":{"state":"observed","value":"1.&nbsp;医疗服务：24小时医师值班+三级查房，老年常见病诊疗、预防保健；小病院内治，大病快速转至莲花医院，保障医疗时效 。 2.&nbsp;养老服务：健康与护理评估定等级，定制照护计划；提供生活照料、膳食、清洁、洗涤等；设养护/安宁/失智/颐养专区，适配不同需求 。 3.&nbsp;护理服务：24小时护士值守，动态评估病情；设伤口护理、静脉输液小组，执行标准化流程；提供半护、全护、临终关怀等差异化照护 。 4.&nbsp;康复服务：配中医康复室与专业医师，结合康复设备+针灸推拿，为术后/后遗症老人定制个性化康复计划 。 5.&nbsp;社工服务：每日组织文娱活动，开展情绪疏导、心理支持、危机干预；为失智老人提供认知训练 。 6.&nbsp;安宁疗护：独立病区，疼痛管理、人文陪伴、家属哀伤辅导一体化服务。 7.居家上门：面向周边5公里社区提供居家照料、医疗护理、心理干预等上门服务 。 8.服务保障：医保定点，多学科协作，定期健康评估，医疗与养老无缝衔接，保障服务质量与安全 。","observationCount":1}},"beds":{"total":{"state":"observed","value":200,"observationCount":1},"dayCare":{"state":"observed","value":0,"observationCount":1},"fullCare":{"state":"observed","value":200,"observationCount":1},"nursing":{"state":"observed","value":200,"observationCount":1}},"feeSummary":[{"code":"04","label":"月总费用","range":{"state":"observed","value":[4000,15800],"observationCount":1},"description":{"state":"observed","value":"基础费用+个性化服务","observationCount":1}},{"code":"02","label":"床位费用","range":{"state":"observed","value":[1200,10000],"observationCount":1},"description":{"state":"observed","value":"按房型、楼层定价","observationCount":1}},{"code":"01","label":"护理费用","range":{"state":"observed","value":[2000,5000],"observationCount":1},"description":{"state":"observed","value":"含生活照料、健康监测等基础服务，鼻饲、气切等特殊管道护理需额外计费","observationCount":1}},{"code":"03","label":"膳食费用","range":{"state":"observed","value":[800,800],"observationCount":1},"description":{"state":"observed","value":"三餐一点","observationCount":1}}],"charges":{"state":"observed","value":[{"id":"d2a757fdd1594ced93e068764bf6b7ea","name":"护理费","description":"能力完好","standard":"2000"},{"id":"35d3537a694a4a8e894564380e3f1e1f","name":"护理费","description":"轻度失能","standard":"2400"},{"id":"f57cec99f59343be87167c5f67d55339","name":"护理费","description":"中度失能","standard":"3000"},{"id":"91e16c2742d548c4b6314172b160e3cd","name":"护理费","description":"重度失能","standard":"4000"},{"id":"f409853dc02445509ac7772c873ff9d2","name":"膳食","description":"1","standard":"800"},{"id":"7b1921125816452a92a8ebea14e62887","name":"护理费","description":"完全失能","standard":"5000"},{"id":"02cb70f90692478f8dbb8b19f4781885","name":"床位费","description":"四人间","standard":"1200"},{"id":"f31fd437024c47f6bc19684b074bc48f","name":"床位费","description":"套房","standard":"10000"},{"id":"4db61f735c804e6395d3497053130c6c","name":"床位费","description":"单间","standard":"7600"},{"id":"5c1f9d418901489f923731428f11b383","name":"床位费","description":"两人间","standard":"3000"},{"id":"f5244ab4abbb45acabbef323399e0fc7","name":"床位费","description":"三人间","standard":"2000"}],"observationCount":1},"evaluation":{"state":"observed","text":"平台评价 1 次 · 综合评价原值 4.5（量表未核）","count":{"state":"observed","value":1,"observationCount":1},"score":{"state":"observed","value":4.5,"observationCount":1}}},"conflictLabels":[],"detailObservedAtUtc":{"earliest":"2026-11-20T06:28:16.781142+00:00","latest":"2026-11-20T06:29:21.591798+00:00"}}

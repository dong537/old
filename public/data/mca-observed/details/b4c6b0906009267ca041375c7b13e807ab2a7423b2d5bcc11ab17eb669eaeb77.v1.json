g":null},{"key":"listedMonthlyFeeMax","label":"月费用上限（平台列示）","text":"4,250 元/月","state":"observed","source":{"channelLabel":"基本详情","fetchedAtUtc":"2026-11-18T18:14:38.799582+00:00"},"warning":null},{"key":"platformStarCode","label":"机构星级原码（评定期未核）","text":"00","state":"observed","source":{"channelLabel":"平台列表","fetchedAtUtc":"2026-11-18T18:06:20.372025+00:00"},"warning":null},{"key":"evaluationCount","label":"平台评价次数","text":"0 次","state":"observed","source":{"channelLabel":"基本详情","fetchedAtUtc":"2026-11-18T18:14:38.799582+00:00"},"warning":null},{"key":"overallEvaluation","label":"平台综合评价原值","text":"暂无评价（原值为 0）","state":"observed","source":{"channelLabel":"基本详情","fetchedAtUtc":"2026-11-18T18:14:38.799582+00:00"},"warning":null},{"key":"functionPositioningLabel","label":"功能定位原标签","text":"原平台未提供","state":"missing","source":null,"warning":null},{"key":"platformTagsRaw","label":"平台标签原文（资格未核）","text":"民办,城区","state":"observed","source":{"channelLabel":"基本详情","fetchedAtUtc":"2026-11-18T18:14:38.799582+00:00"},"warning":null}],"platformDetail":{"identity":{"facilityType":{"state":"observed","value":"养老机构","observationCount":2},"starCode":{"state":"observed","value":"00","observationCount":2},"functionPositioning":{"state":"missing","value":null,"observationCount":0},"region":{"state":"observed","value":"河南省/开封市/杞县","observationCount":2},"address":{"state":"observed","value":"杞县金城大道西段","observationCount":2}},"tags":{"state":"observed","value":["民办","城区"],"observationCount":1},"subsidyCode":{"state":"observed","value":"1","observationCount":1},"contactName":{"state":"observed","value":"吴明太","observationCount":1},"contactPhone":{"state":"observed","value":"13837845456","observationCount":1},"pointRaw":{"state":"observed","value":"114.77176,34.54883","observationCount":1},"photoCount":{"state":"observed","value":1,"observationCount":1},"areaSqm":{"state":"observed","value":8000,"observationCount":1},"introduction":{"state":"observed","value":"感觉龚宇。位于开封市杞县经四路与金城大道交叉口，西林杞县人民医院，酒店式管理有南北花园自己重有花鼓、蔬菜。饮食，经过专业培训和从业多年的厨师料理，依据入住老人口味和需求制定食谱。早餐品种多样，科学配餐，午餐荤素搭配，营养均衡，晚餐松软可口且不失营养。24小时专人护理，做到尊老、敬老、和谐的生活气氛，让老人安享晚年。","observationCount":1},"service":{"content":{"state":"observed","value":"养老院提供住宿照料、膳食供应、日常护理，含助浴、助行等。配备基础医疗服务，如健康监测、用药协助。组织文化娱乐活动，兼顾心理关怀，满足老年人生活、健康及精神需求。","observationCount":1},"team":{"state":"observed","value":"养老院服务团队涵盖多专业角色。护理团队是核心，由持证护理员、护士组成，负责日常照料、健康监测、用药协助及应急护理，熟悉老年常见病照护需求。 厨师团队根据老年人饮食特点，定制营养均衡的膳食，兼顾软食、低糖等特殊需求，保障饮食安全与口感。 后勤管理部负责住宿环境维护、设施检修、安全巡查，确保居住舒适安全。部分养老院还配备社工或心理咨询师，组织文娱活动，提供情感支持，多方协作满足老人生活与精神需求。","observationCount":1},"hours":{"state":"observed","value":"全年无休","observationCount":1},"scope":{"state":"observed","value":"养老院服务范围涵盖老年人生活、健康及精神需求的多个维度。 生活照料是基础，包括提供整洁住宿、规律膳食（可满足低糖、软食等特殊需求），协助日常起居如穿衣、洗漱、助浴、如厕等，还负责个人卫生维护与衣物清洗。 健康保障是核心，配备护理人员监测老人血压、血糖等基础体征，协助用药管理；部分机构与医疗机构合作，提供定期体检、慢病管理服务，对失能、半失能老人提供专业照护，包括压疮预防、康复辅助等。 精神关怀不可少，通过组织文娱活动如书画、棋牌、歌咏等丰富生活，安排节日庆祝、生日会增强归属感；配备社工或心理咨询师，提供情感疏导，缓解孤独感。 后勤支持保障运转，涵盖环境保洁、设施维修、安全巡查（防火、防滑等），部分机构提供代购、理发等便民服务。 此外，部分养老院还提供短期托养、临时照护等灵活服务，满足家庭临时照护需求，全方位为老年人营造安全、舒适、有温度的居住环境。","observationCount":1},"explanation":{"state":"observed","value":"养老院服务以“专业照护、人文关怀”为核心，覆盖老年人生活全场景需求。 生活照料方面，提供单人或双人住宿，定期清洁维护；膳食由专业厨师定制，每日搭配营养均衡的三餐，可根据健康状况调整为软食、低糖、低盐等特殊餐食。护理人员协助日常起居，包括穿衣、洗漱、助浴、如厕等，保障个人卫生与生活便捷。 健康服务是重点，配备持证护理员实时监测血压、血糖等基础体征，协助按时用药；针对失能、半失能老人提供专业照护，如压疮护理、康复训练辅助等。部分机构与医院合作，开通绿色就诊通道，提供定期体检、慢病管理服务，突发状况可及时响应处理。 精神关怀贯穿日常，定期组织书画、棋牌、歌咏等文娱活动，节日举办庆祝会、生日会，增强老人归属感。社工或心理咨询师提供情感疏导，缓解孤独情绪，鼓励老人社交互动。 后勤保障全面到位，每日环境保洁、设施检修，定期安全巡查（防火、防滑、防跌倒），保障居住安全。部分机构提供代购、理发、接送等便民服务，满足个性化需求。 服务形式灵活，可提供长期住养、短期托养等选择，全方位为老年人打造安全、舒适、有温度的养老环境，让老人安享晚年。","observationCount":1}},"beds":{"total":{"state":"observed","value":180,"observationCount":1},"dayCare":{"state":"observed","value":0,"observationCount":1},"fullCare":{"state":"observed","value":180,"observationCount":1},"nursing":{"state":"observed","value":150,"observationCount":1}},"feeSummary":[{"code":"04","label":"月总费用","range":{"state":"observed","value":[1100,4250],"observationCount":1},"description":{"state":"observed","value":"老人入住机构每人每月1100元起","observationCount":1}},{"code":"02","label":"床位费用","range":{"state":"observed","value":[450,650],"observationCount":1},"description":{"state":"observed","value":"每人每月450元起","observationCount":1}},{"code":"01","label":"护理费用","range":{"state":"observed","value":[200,3000],"observationCount":1},"description":{"state":"observed","value":"全自理每人每月200元起，半失能每人每月1500元起，全失能每人每月2500元起","observationCount":1}},{"code":"03","label":"膳食费用","range":{"state":"observed","value":[450,600],"observationCount":1},"description":{"state":"observed","value":"每人每月450元起","observationCount":1}}],"charges":{"state":"observed","value":[{"id":"51ff283996ab48269e47982a83dfe942","name":"老年人照护服务","description":"养老院提供住宿照料、膳食供应、日常护理，含助浴、助行等。配备基础医疗服务，如健康监测、用药协助。组织文化娱乐活动，兼顾心理关怀，满足老年人生活、健康及精神需求。","standard":"1100元起"}],"observationCount":1},"evaluation":{"state":"observed","text":"暂无平台评价","count":{"state":"observed","value":0,"observationCount":2},"score":{"state":"observed","value":0,"observationCount":2}}},"conflictLabels":[],"detailObservedAtUtc":{"earliest":"2026-11-18T18:14:38.799582+00:00","latest":"2026-11-18T18:14:53.144057+00:00"}}

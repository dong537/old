null},{"key":"listedMonthlyFeeMax","label":"月费用上限（平台列示）","text":"17,400 元/月","state":"observed","source":{"channelLabel":"基本详情","fetchedAtUtc":"2026-11-19T19:05:05.212538+00:00"},"warning":null},{"key":"platformStarCode","label":"机构星级原码（评定期未核）","text":"02","state":"observed","source":{"channelLabel":"平台列表","fetchedAtUtc":"2026-11-19T14:01:11.729606+00:00"},"warning":null},{"key":"evaluationCount","label":"平台评价次数","text":"0 次","state":"observed","source":{"channelLabel":"基本详情","fetchedAtUtc":"2026-11-19T19:05:05.212538+00:00"},"warning":null},{"key":"overallEvaluation","label":"平台综合评价原值","text":"暂无评价（原值为 0）","state":"observed","source":{"channelLabel":"基本详情","fetchedAtUtc":"2026-11-19T19:05:05.212538+00:00"},"warning":null},{"key":"functionPositioningLabel","label":"功能定位原标签","text":"原平台未提供","state":"missing","source":null,"warning":null},{"key":"platformTagsRaw","label":"平台标签原文（资格未核）","text":"民办,长护险定点机构,医养结合养老机构,内设医疗机构,城区","state":"observed","source":{"channelLabel":"基本详情","fetchedAtUtc":"2026-11-19T19:05:05.212538+00:00"},"warning":null}],"platformDetail":{"identity":{"facilityType":{"state":"observed","value":"养老机构","observationCount":1},"starCode":{"state":"observed","value":"02","observationCount":1},"functionPositioning":{"state":"missing","value":null,"observationCount":0},"region":{"state":"observed","value":"上海市/长宁区","observationCount":1},"address":{"state":"observed","value":"长宁区新泾镇新泾路118号","observationCount":1}},"tags":{"state":"observed","value":["民办","长护险定点机构","医养结合养老机构","内设医疗机构","城区"],"observationCount":1},"subsidyCode":{"state":"observed","value":"1","observationCount":1},"contactName":{"state":"observed","value":"上海南山敬老院","observationCount":1},"contactPhone":{"state":"observed","value":"13391449331","observationCount":1},"pointRaw":{"state":"observed","value":"121.36184,31.20418","observationCount":1},"photoCount":{"state":"observed","value":6,"observationCount":1},"areaSqm":{"state":"observed","value":3917,"observationCount":1},"introduction":{"state":"observed","value":"南山敬老院位于长宁区新泾路118号，是经民政部门依法审批设立的规范化、专业化医养结合养老服务机构，为本市长护险定点机构，可核销政府养老服务消费券，帮助减轻家庭照护负担。本院占地面积5430平方米，建筑面积3917平方米，区位环境优越、交通便利、环境整洁静谧，院内整体按照适老化标准规划建设，布局合理、采光通风良好、绿化充足。设有单人间、双人间、三人间，房间独立配套卫生间、空调、电扇、有线电视、电话、紧急呼叫器，可满足自理、半失能、失能等不同身体状况长者的入住需求。院内配备专业护理团队，提供24小时生活照料、营养膳食、慢病监测、康复护理、文娱陪伴等服务，协助家属办理长护险评估结算与养老消费券申领核销，用心为长者打造安心舒适的养老居所。","observationCount":1},"service":{"content":{"state":"observed","value":"生活照料服务：提供24小时全天候值守服务，包含日常起居照料、穿衣洗漱、助餐助浴、如厕陪护、定期理发修剪指甲、日常清洁整理等基础生活服务，根据老人身体状况定制个性化照料方案。 膳食营养服务：设立标准化老年食堂，配备专业后勤人员，遵循低盐、低脂、软烂易消化的老年饮食原则，科学搭配每日膳食，定期更新菜谱。针对慢病老人、牙口不佳老人提供流质、半流质定制餐食，实行分餐、留样管理制度，保障饮食安全、营养均衡。 医疗健康服务：构建完善医养结合服务体系，配备专业护理人员，常态化开展血压、血糖监测、日常健康巡查、慢病管理、用药督导服务。同时与周边正规医院建立绿色就医通道，实现小病院内养护、大病快速转诊，全程守护长者身体健康。 康复文娱服务：定期组织康复训练、健身锻炼、趣味文娱、棋牌娱乐、红色观影、节日联欢等活动，陪伴长者欢度春节、端午、中秋、重阳等传统节日，为高龄、独居老人开展心理疏导与精神慰藉，丰富老年精神文化生活。 专项照护服务：针对失能、失智、术后康复长者，提供一对一精准护理、压疮预防、翻身叩背、管道护理等专项服务，全程规范操作，提升长者晚年生活质量与尊严。","observationCount":1},"team":{"state":"observed","value":"院内组建了一支经验丰富、责任心强的专业服务团队，包含持证护士、专业护理员、后勤保障、安全值守等专职人员，所有在岗人员持证上岗、定期培训考核，具备扎实的养老护理与应急处置能力，以专业、耐心、细心、爱心的服务态度，为每一位长者提供高品质养老服务。","observationCount":1},"hours":{"state":"observed","value":"24小时全天候值守服务","observationCount":1},"scope":{"state":"observed","value":"服务内容有：进食、修饰及洗浴、穿（脱）衣、排泄及如厕、移动、压疮护理、物品整理、用药、膳食、衣物洗涤等。另外，南山敬老院配有专职的医护团队，可做到从老年人的日常生活照护到老年人的健康管理，以及老年人的身体康复等方面全覆盖。","observationCount":1},"explanation":{"state":"observed","value":"我们始终秉持着“有爱心、有热心、有耐心、有细心、有真心，有责任心”的服务理念，关注老年人的需求和感受，努力为老年人创造一个温馨、舒适、安全的晚年生活。","observationCount":1}},"beds":{"total":{"state":"observed","value":156,"observationCount":1},"dayCare":{"state":"observed","value":0,"observationCount":1},"fullCare":{"state":"observed","value":156,"observationCount":1},"nursing":{"state":"observed","value":40,"observationCount":1}},"feeSummary":[{"code":"04","label":"月总费用","range":{"state":"observed","value":[9400,17400],"observationCount":1},"description":{"state":"observed","value":"总费用包含床位、护理、膳食、康复及其他服务，按房型和照护等级核算；支持长护险结算、养老服务消费券核销。","observationCount":1}},{"code":"02","label":"床位费用","range":{"state":"observed","value":[6500,12500],"observationCount":1},"description":{"state":"observed","value":"提供单人间/双人间/三人间住宿，房间配套独立卫生间、空调、呼叫器等适老化设施。","observationCount":1}},{"code":"01","label":"护理费用","range":{"state":"observed","value":[2000,4000],"observationCount":1},"description":{"state":"observed","value":"一对一护理价格需面议，按老人照护等级提供分级生活照料、健康监测、压疮预防、用药督导等护理服务。长宁区户籍老人享受优惠100元/人/月。","observationCount":1}},{"code":"03","label":"膳食费用","range":{"state":"observed","value":[900,900],"observationCount":1},"description":{"state":"observed","value":"提供适合老年人的低盐软烂营养餐，按需提供流质、半流质定制餐，落实食品留样管理。","observationCount":1}}],"charges":{"state":"observed","value":[{"id":"63f60eaca9334ec1bdf89e08002fc239","name":"床位费","description":"提供单人间/双人间/三人间住宿，房间配套独立卫生间、空调、呼叫器等适老化设施。","standard":"6500元-12500元"},{"id":"c42597bb3ff54560a001c8e9c32733e1","name":"护理费","description":"按老人照护等级提供分级生活照料、健康监测、压疮预防、用药督导等护理服务。","standard":"2000元-4000元 一对一面议"},{"id":"23635d3ce9b344d4ae62441be487146c","name":"膳食费","description":"提供适合老年人的低盐软烂营养餐，按需提供流质、半流质定制餐，落实食品留样管理。","standard":"900"}],"observationCount":1},"subServices":{"respite":{"beds":{"state":"missing","value":null,"observationCount":0},"nursingBeds":{"state":"missing","value":null,"observationCount":0},"fee":{"state":"missing","value":null,"observationCount":0},"unit":"元/天","project":{"state":"missing","value":null,"observationCount":0},"charges":{"state":"missing","value":null,"observationCount":0}},"dayCare":{"beds":{"state":"missing","value":null,"observationCount":0},"nursingBeds":{"state":"missing","value":null,"observationCount":0},"fee":{"state":"missing","value":null,"observationCount":0},"unit":"元/天","project":{"state":"missing","value":null,"observationCount":0},"charges":{"state":"missing","value":null,"observationCount":0}},"homeVisit":{"beds":{"state":"missing","value":null,"observationCount":0},"nursingBeds":{"state":"missing","value":null,"observationCount":0},"fee":{"state":"missing","value":null,"observationCount":0},"unit":"元/次
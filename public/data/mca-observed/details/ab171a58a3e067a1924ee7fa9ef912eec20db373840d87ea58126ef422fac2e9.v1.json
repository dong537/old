null},{"key":"listedMonthlyFeeMax","label":"月费用上限（平台列示）","text":"4,200 元/月","state":"observed","source":{"channelLabel":"基本详情","fetchedAtUtc":"2026-11-18T18:13:27.634689+00:00"},"warning":null},{"key":"platformStarCode","label":"机构星级原码（评定期未核）","text":"00","state":"observed","source":{"channelLabel":"平台列表","fetchedAtUtc":"2026-11-18T18:06:20.372025+00:00"},"warning":null},{"key":"evaluationCount","label":"平台评价次数","text":"0 次","state":"observed","source":{"channelLabel":"基本详情","fetchedAtUtc":"2026-11-18T18:13:27.634689+00:00"},"warning":null},{"key":"overallEvaluation","label":"平台综合评价原值","text":"暂无评价（原值为 0）","state":"observed","source":{"channelLabel":"基本详情","fetchedAtUtc":"2026-11-18T18:13:27.634689+00:00"},"warning":null},{"key":"functionPositioningLabel","label":"功能定位原标签","text":"原平台未提供","state":"missing","source":null,"warning":null},{"key":"platformTagsRaw","label":"平台标签原文（资格未核）","text":"民办,长护险定点机构,城区","state":"observed","source":{"channelLabel":"基本详情","fetchedAtUtc":"2026-11-18T18:13:27.634689+00:00"},"warning":null}],"platformDetail":{"identity":{"facilityType":{"state":"observed","value":"养老机构","observationCount":2},"starCode":{"state":"observed","value":"00","observationCount":2},"functionPositioning":{"state":"missing","value":null,"observationCount":0},"region":{"state":"observed","value":"河南省/开封市/杞县","observationCount":2},"address":{"state":"observed","value":"杞苏公路北段路西","observationCount":2}},"tags":{"state":"observed","value":["民办","长护险定点机构","城区"],"observationCount":1},"subsidyCode":{"state":"observed","value":"1","observationCount":1},"contactName":{"state":"observed","value":"李爱玲","observationCount":1},"contactPhone":{"state":"observed","value":"28998309","observationCount":1},"pointRaw":{"state":"observed","value":"114.55989,34.36983","observationCount":1},"photoCount":{"state":"observed","value":1,"observationCount":1},"areaSqm":{"state":"observed","value":4200,"observationCount":1},"introduction":{"state":"observed","value":"凤玲老年公寓是一所于2003年开建并俊工，2004年5月投入使用，座落于杞县高阳路口，杞苏路北段路西，占地面积3600平方米，建筑面积4200平方米。院内设有办公室，值班室，居住区，餐厅等，共计85间房，床位99，并设有健身器材区，康复保健室，文化娱乐室，阅读室，棋盘室等，消防安全设施齐全，为在住老人提供完善的健康食宿条件，健全的保健康复制度，丰富的阅读娱乐与一体的安逸舒适生活环境。","observationCount":1},"service":{"content":{"state":"observed","value":"养老提供住宿照料、膳食供应、日常护理，含助浴、助行等。配备基础医疗服务，如健康、康复、测量血压、血糖用药协助等，组织娱乐活动，兼顾心里关怀、临终关怀，满足老人健康和精神需求。","observationCount":1},"team":{"state":"observed","value":"养老院护理团队多专业人员组成。护理团队为中心，有医生、有护士、护理员负责日常照料健康监测、用药协助和应急护理，熟悉老人的身体状况。厨师团队根据老人的饮食特点定制营养均衡餐，兼顾软食、流食、低糖的特殊需求，保障饮食的安全与口感。后勤管理负责住宿环境维护设施检修、安全巡查确保老人居住舒适安全。咱院内还有义工组织文艺活动，提供情感支持，满足老人生活与精神需求。","observationCount":1},"hours":{"state":"observed","value":"全年无休","observationCount":1},"scope":{"state":"observed","value":"养老院服务范围包括老年人生活、健康及精神需求的多个方面。生活照料是基础，提供整洁住宿、饮食规律、协助日常起居、如：穿衣、洗漱、如厕、洗浴等、还有个人卫生维护与衣物清洗。健康保障是核心，配备医护人员给老人测量血压、血糖基础体征、协助用药管理，机构与医疗机构合作，提供定期体检、慢病管理服务，对失能半失能老人提供专业照护，包括压疮预防、健康辅助等。精神关怀不可少，通过组织文娱活动如书画、棋牌、歌咏等丰富生活，安排节日庆祝、生日会增强归属感；有社工或心里咨询师，提供情感疏导，缓解孤独感。后勤支持保障运转，涵盖环境保洁、设施维修、安全巡查等，机构提供代购、理发等便民服务。此外，养老院还提供短期托养、临时照护等灵活服务，满足家庭临时照护需求，全方位为老人营造安全、舒适、有温度的居住环境。","observationCount":1},"explanation":{"state":"observed","value":"养老院服务以专业照护、人文关怀为核心。覆盖老年人生活全场景需求。生活照料方面，提供单人或双人住宿，定期清洁维护；膳食由专业厨师定制，每日搭配营养均衡的三餐，可根据健康状况调整为软食、低糖、低盐等特殊餐食。护理人员协助日常起居，包括穿衣、洗漱、助浴、如厕等，保障个人卫生与生活便捷。健康服务是重点，配备持证护理员实时监测血压、血糖等基础体征，协助按时用药；针对失能半失能提供专业照护，如压疮护理、康复训练辅助等机构与医院合作，开通绿色就诊通道，提供定期体检、慢病管理服务，突发状况可及时响应处理。精神关怀贯穿日常，定期组织书画、歌咏等文艺活动，节日举办庆功会、生日会，增强老人归属感。社工或心理咨询师提供情感疏导，缓解孤独情绪，鼓励老人社交互动。后勤保障全面到位，每日环境保洁，设施检修，定期安全巡查，保障居住安全。满足个性话需求服务形式灵活，可提供长期住养、短期托养等选择。","observationCount":1}},"beds":{"total":{"state":"observed","value":99,"observationCount":1},"dayCare":{"state":"observed","value":0,"observationCount":1},"fullCare":{"state":"observed","value":99,"observationCount":1},"nursing":{"state":"observed","value":61,"observationCount":1}},"feeSummary":[{"code":"04","label":"月总费用","range":{"state":"observed","value":[1000,4200],"observationCount":1},"description":{"state":"observed","value":"自理老人护理费、床位费、膳食费1000元。全失能老人护理费、床位费、营养膳食费4200元","observationCount":1}},{"code":"02","label":"床位费用","range":{"state":"observed","value":[500,900],"observationCount":1},"description":{"state":"observed","value":"自理老人床位费500元，全失能老人床位费900元","observationCount":1}},{"code":"01","label":"护理费用","range":{"state":"observed","value":[100,2800],"observationCount":1},"description":{"state":"observed","value":"自理老人护理费100元，全失能老人护理费2800元","observationCount":1}},{"code":"03","label":"膳食费用","range":{"state":"observed","value":[400,500],"observationCount":1},"description":{"state":"observed","value":"正常膳食400元，营养低糖膳食500元","observationCount":1}}],"charges":{"state":"observed","value":[{"id":"22735f818c9947e081cdc77fb2ab717f","name":"养老服务","description":"自理老人：为老人提供住宿、餐饮、洗衣服、打扫房间卫生。半自理老人：1.进食：喂饭.帮忙夹菜、切食物、2.穿衣：帮忙穿脱衣服整理衣服、3：洗澡、帮忙搀扶、洗全程看护、4.如厕：需要搀扶、帮忙擦、处理失禁、5.床椅转移：需要人扶、抱、拉一把、6.平地行走：需要拐杖、搀扶、走不动。全失能重度失能老人服务范围：1.生活照料：进食、喂水、喂药，穿衣、脱衣、整理，洗脸、洗手、口腔护理，梳头刮胡子、修指甲，洗脚、擦身、定期洗澡，翻身拍背更换体位，整理床铺、更换床单被罩，2.排泄护理：上厕所、使用便盆、尿壶，纸尿裤更换、臀部清洁、防褥疮护理、观察大小便情况。3.行动与转移：床上移动、翻身起坐、轮椅转移。4.皮","standard":"1000-4200"}],"observationCount":1},"evaluation":{"state":"observed","text":"暂无平台评价","count":{"state":"observed","value":0,"observationCount":2},"score":{"state":"observed","value":0,"observationCount":2}}},"conflictLabels":[],"detailObservedAtUtc":{"earliest":"2026-11-18T18:13:27.634689+00:00","latest":"2026-11-18T18:13:39.306830+00:00"}}

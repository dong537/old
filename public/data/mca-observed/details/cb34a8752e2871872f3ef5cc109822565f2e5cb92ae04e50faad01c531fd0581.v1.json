"},"warning":null},{"key":"listedMonthlyFeeMax","label":"月费用上限（平台列示）","text":"3,500 元/月","state":"observed","source":{"channelLabel":"基本详情","fetchedAtUtc":"2026-11-19T11:40:19.735191+00:00"},"warning":null},{"key":"platformStarCode","label":"机构星级原码（评定期未核）","text":"02","state":"observed","source":{"channelLabel":"平台列表","fetchedAtUtc":"2026-11-19T06:54:17.310888+00:00"},"warning":null},{"key":"evaluationCount","label":"平台评价次数","text":"0 次","state":"observed","source":{"channelLabel":"基本详情","fetchedAtUtc":"2026-11-19T11:40:19.735191+00:00"},"warning":null},{"key":"overallEvaluation","label":"平台综合评价原值","text":"暂无评价（原值为 0）","state":"observed","source":{"channelLabel":"基本详情","fetchedAtUtc":"2026-11-19T11:40:19.735191+00:00"},"warning":null},{"key":"functionPositioningLabel","label":"功能定位原标签","text":"原平台未提供","state":"missing","source":null,"warning":null},{"key":"platformTagsRaw","label":"平台标签原文（资格未核）","text":"公建民营,医养结合养老机构,与医疗机构签约合作,农村","state":"observed","source":{"channelLabel":"基本详情","fetchedAtUtc":"2026-11-19T11:40:19.735191+00:00"},"warning":null}],"platformDetail":{"identity":{"facilityType":{"state":"observed","value":"养老机构","observationCount":2},"starCode":{"state":"observed","value":"02","observationCount":2},"functionPositioning":{"state":"missing","value":null,"observationCount":0},"region":{"state":"observed","value":"海南省/海口市/龙华区","observationCount":2},"address":{"state":"observed","value":"海口市龙华区遵谭镇珠崖路93号","observationCount":2}},"tags":{"state":"observed","value":["公建民营","医养结合养老机构","与医疗机构签约合作","农村"],"observationCount":1},"subsidyCode":{"state":"observed","value":"1","observationCount":1},"contactName":{"state":"observed","value":"邱小花","observationCount":1},"contactPhone":{"state":"observed","value":"18976576887","observationCount":1},"pointRaw":{"state":"observed","value":"110.30816,19.81095","observationCount":1},"photoCount":{"state":"observed","value":3,"observationCount":1},"areaSqm":{"state":"observed","value":2100,"observationCount":1},"introduction":{"state":"observed","value":"遵谭镇敬老院于2003年筹划，2008年立项，2009年10月开工兴建，2010年3竣工交付使用，2010年5月入住；敬老院总面积 13亩，建筑面积1300平方米，绿化面积3000平方米，种植区6亩，院内房前房后树木成排，小径宛转，敬老院两面临山，大门口水泥路面直达，交通便利，环境优美。院内床位46个，现入住22人，其中五保18人，其他4人。敬老院引进社会化管理，2010年5月由家美乐老人服务中心管理；2022年1月由海口市龙华区阳光居家养老服务中心管理，是一家实行“五保户托养+社会老人入住”二合一”混合模式的集生活护理、娱乐、康复、健身为一体的公建民营型社会养老机构。 温馨的环境 位于海南省海口市龙华区遵谭镇珠崖路93号，隐于海口市遵谭镇上，空气清新，环境幽静优雅。建筑结构为平房。设有厨房、办公室、仓库、护理值班室、餐厅、娱乐室和老人房间。老人房间内环境敞亮，有独立卫生间、床头柜、衣柜、风扇、等生活设施。还有24小时热水供应，室内外均配备各种娱乐项目和健身器材，如麻将桌、棋牌桌等。娱乐室内的电视每天都会播放老人喜欢的综艺节目或者海南琼剧，","observationCount":1},"service":{"content":{"state":"observed","value":"（1）安排工作人员值班，巡视老人房间。 （2）每日清扫老人房间，做环境卫生 （3）每周换洗一次被罩、床单、枕巾（必要时随时换洗） （4）定期修剪指甲，为老人理发，保持老人仪表端庄。 （5）督促老人洗澡及更换衣物，保持皮肤清洁卫生。 （6）定期组织老人文体活动。 （7）细心观察老人的身体情况，定时监测老人生命体征，帮助老人解决病痛。 （8）耐心倾听老人的心声，和老人聊天多沟通，了解老人的需求，满足老人的需求。","observationCount":1},"team":{"state":"observed","value":"院团队是一支具有丰富经验和爱心、耐心、细心的团队，旨在为广大老年人提供专业、规范、温馨的服务。包括院长、护理员、厨师等。持证上岗。完善的管理制度、服务标准化，是我们的服务基础。我们的服务愿景是全心全意为老年人服务。通过为老人提供优质化的服务，满足不同老年人多层次、多样化服务需求更是我们的服务目标。","observationCount":1},"hours":{"state":"observed","value":"遵谭镇敬老院于2003年筹划，2008年立项，2009年10月开工兴建，2010年3竣工交付使用，2010年5月入住；敬老院总面积 13亩，建筑面积1300平方米，绿化面积3000平方米，种植区6亩，院内房前房后树木成排，小径宛转，敬老院两面临山，大门口水泥路面直达，交通便利，环境优美。敬老院引进社会化管理，2010年5月由家美乐老人服务中心管理；2022年1月由海口市龙华区阳光居家养老服务中心管理，是一家实行“五保户托养+社会老人入住”二合一”混合模式的集生活护理、娱乐、康复、健身为一体的公建民营型社会养老机构。","observationCount":1},"scope":{"state":"observed","value":"实行“特困托养+社会老人+老年人日间照料”三合一”混合模式的集生活照料、护理保健、康复治疗、定期检查、休闲娱乐、健身为一体的公建民营","observationCount":1},"explanation":{"state":"observed","value":"1.环境安全、生活规律：敬老院白天晚上都有工作人员，而且有基本的医疗设备。能让老人过上有规律的生活，每天按时起居的生活有利于老人的身心健康。 2.减轻老人的孤独感：敬老院有许多年龄相仿的老伙伴能让老人容易找到志趣相同的伙伴。还有比较丰富的业余活动且基础设施好、组织定期的身体检查。","observationCount":1}},"beds":{"total":{"state":"observed","value":46,"observationCount":1},"dayCare":{"state":"observed","value":0,"observationCount":1},"fullCare":{"state":"observed","value":46,"observationCount":1},"nursing":{"state":"observed","value":10,"observationCount":1}},"feeSummary":[{"code":"04","label":"月总费用","range":{"state":"observed","value":[2000,3500],"observationCount":1},"description":{"state":"observed","value":"包含护理费、床位费、膳食费","observationCount":1}},{"code":"02","label":"床位费用","range":{"state":"observed","value":[680,680],"observationCount":1},"description":{"state":"observed","value":"包含床位使用权、房间基础设施使用，以及公共区域与房间日常保洁、公共 水电等","observationCount":1}},{"code":"01","label":"护理费用","range":{"state":"observed","value":[740,2240],"observationCount":1},"description":{"state":"observed","value":"自理级别无需专人照料，半自理级别需部分生活照料及基础护理，失能级别需专人照料及基础护理","observationCount":1}},{"code":"03","label":"膳食费用","range":{"state":"observed","value":[580,580],"observationCount":1},"description":{"state":"observed","value":"包含一日三餐的食材供应、膳食加工制作、分餐配送，餐具清洗消毒、厨房卫生保洁。","observationCount":1}}],"charges":{"state":"observed","value":[{"id":"1c791f9f8b304a96ba317b1cbdea79f6","name":"机构服务","description":"长期入住养老机构，接受全天候照顾，服务内容生活照料，医疗护理，精神慰藉","standard":"2000-3500"}],"observationCount":1},"evaluation":{"state":"observed","text":"暂无平台评价","count":{"state":"observed","value":0,"observationCount":2},"score":{"state":"observed","value":0,"observationCount":2}}},"conflictLabels":[],"detailObservedAtUtc":{"earliest":"2026-11-19T11:40:19.735191+00:00","latest":"2026-11-19T11:41:21.311956+00:00"}}

},"warning":null},{"key":"listedMonthlyFeeMax","label":"月费用上限（平台列示）","text":"6,000 元/月","state":"observed","source":{"channelLabel":"基本详情","fetchedAtUtc":"2026-11-19T16:17:16.151611+00:00"},"warning":null},{"key":"platformStarCode","label":"机构星级原码（评定期未核）","text":"00","state":"observed","source":{"channelLabel":"平台列表","fetchedAtUtc":"2026-11-19T16:05:31.795424+00:00"},"warning":null},{"key":"evaluationCount","label":"平台评价次数","text":"0 次","state":"observed","source":{"channelLabel":"基本详情","fetchedAtUtc":"2026-11-19T16:17:16.151611+00:00"},"warning":null},{"key":"overallEvaluation","label":"平台综合评价原值","text":"暂无评价（原值为 0）","state":"observed","source":{"channelLabel":"基本详情","fetchedAtUtc":"2026-11-19T16:17:16.151611+00:00"},"warning":null},{"key":"functionPositioningLabel","label":"功能定位原标签","text":"原平台未提供","state":"missing","source":null,"warning":null},{"key":"platformTagsRaw","label":"平台标签原文（资格未核）","text":"民办,医养结合养老机构,与医疗机构签约合作,城区","state":"observed","source":{"channelLabel":"基本详情","fetchedAtUtc":"2026-11-19T16:17:16.151611+00:00"},"warning":null}],"platformDetail":{"identity":{"facilityType":{"state":"observed","value":"养老机构","observationCount":1},"starCode":{"state":"observed","value":"00","observationCount":1},"functionPositioning":{"state":"missing","value":null,"observationCount":0},"region":{"state":"observed","value":"江苏省/常州市/天宁区","observationCount":1},"address":{"state":"observed","value":"常州市天宁区翠竹新村76号","observationCount":1}},"tags":{"state":"observed","value":["民办","医养结合养老机构","与医疗机构签约合作","城区"],"observationCount":1},"subsidyCode":{"state":"observed","value":"1","observationCount":1},"contactName":{"state":"observed","value":"刘燕","observationCount":1},"contactPhone":{"state":"observed","value":"13606149079","observationCount":1},"pointRaw":{"state":"observed","value":"119.98346,31.79784","observationCount":1},"photoCount":{"state":"observed","value":3,"observationCount":1},"areaSqm":{"state":"observed","value":1038.38,"observationCount":1},"introduction":{"state":"observed","value":"天运医养结合养老护理院位于翠竹新村南区76号，交通便捷，方便家属探望及老年人出行。占地6亩，建筑面积2719.17平方米，独门独院封闭式院落，环境幽雅，闹中取静。院子四周三层建筑楼房，户外活动场地有1000多平方米，聘请专业有资质的医生、护士、社工、护工等专业人员，是一所康复、护理、养老及居家服务为一体的专业康复护理院。 使命：让天下儿女尽孝有道，让阳光照进老人心田 愿景：与儿女共同承担养老孝道，陪老人共同经营人生美好。让养老变享老，让孝老融敬老 价值观：尊重、体恤、耐心、包容、仁爱 送笑容，给陪伴，用真心，做善人","observationCount":1},"service":{"content":{"state":"observed","value":"本机构为己完成民政备案的养老服务机构，设置床位50张，实际开放床位41张，主要接收自理、半失能、失能老年人，提供机构住养、生活照料、基础护理、康复指导、膳食服务、心理慰藉等养老服务。机构场地符合养老建筑规范，设置无障碍通道、室内呼叫系统、防滑地面等适老化设施;消防设施齐全，已完成消防相关验收备案","observationCount":1},"team":{"state":"observed","value":"机构配备管理人员、执业医师、护士、持证养老护理员等专业人员。管理人员负责机构运营、质量管控;医师、护士负责长者健康监测、慢病管理:养老护理员持证上岗，按照长者能力评估等级落实分级护理服务。用工规范，在职人员签订劳动合同、缴纳社保:退休返聘人员签订劳务协议，留存退休证明。定期组织护理、安全、长护险政策专项培训，持续提升照护服务能力。","observationCount":1},"hours":{"state":"observed","value":"长者入院时开展老年人能力评估，确定护理等级，制定个性化护理服务计划;长者健康状况发生变化及时复评，动态调整护理方案。日常落实分级照护服务，包含晨间晚间护理、进食协助、翻身叩背、压疮预防、如厕洗浴照料、定时巡房等;建立长者诉求处理机制，及时响应家属意见。 已与医疗机构签订医养合作协议，合作医疗机构定期上门巡诊，开展慢性病健康管理、慢性病配药服务，发生急症开通绿色转诊通道。","observationCount":1},"scope":{"state":"observed","value":"长者入院时开展老年人能力评估，确定护理等级，制定个性化护理服务计划;长者健康状况发生变化及时复评，动态调整护理方案。日常落实分级照护服务，包含晨间晚间护理、进食协助、翻身叩背、压疮预防、如厕洗浴照料、定时巡房等;建立长者诉求处理机制，及 时响应家属意见。","observationCount":1},"explanation":{"state":"observed","value":"长者入院时开展老年人能力评估，确定护理等级，制定个性化护理服务计划;长者健康状况发生变化及时复评，动态调整护理方案。日常落实分级照护服务，包含晨间晚间护理、进食协助、翻身叩背、压疮预防、如厕洗浴照料、定时巡房等;建立长者诉求处理机制，及时响应家属意见。 已与医疗机构签订医养合作协议，合作医疗机构定期上门巡诊，开展慢性病健康管理、慢性病配药服务，发生急症开通绿色转诊通道。","observationCount":1}},"beds":{"total":{"state":"observed","value":41,"observationCount":1},"dayCare":{"state":"observed","value":0,"observationCount":1},"fullCare":{"state":"observed","value":41,"observationCount":1},"nursing":{"state":"observed","value":0,"observationCount":1}},"feeSummary":[{"code":"04","label":"月总费用","range":{"state":"observed","value":[3600,6000],"observationCount":1},"description":{"state":"observed","value":"护理费、床位费、膳食费","observationCount":1}},{"code":"02","label":"床位费用","range":{"state":"observed","value":[2000,3500],"observationCount":1},"descripti
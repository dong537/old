:"missing","source":null,"warning":null},{"key":"evaluationCount","label":"平台评价次数","text":"0 次","state":"observed","source":{"channelLabel":"基本详情","fetchedAtUtc":"2026-11-20T12:57:49.286046+00:00"},"warning":null},{"key":"overallEvaluation","label":"平台综合评价原值","text":"暂无评价（原值为 0）","state":"observed","source":{"channelLabel":"基本详情","fetchedAtUtc":"2026-11-20T12:57:49.286046+00:00"},"warning":null},{"key":"functionPositioningLabel","label":"功能定位原标签","text":"原平台未提供","state":"missing","source":null,"warning":null},{"key":"platformTagsRaw","label":"平台标签原文（资格未核）","text":"民办,医养结合养老机构,内设医疗机构,与医疗机构签约合作,城区","state":"observed","source":{"channelLabel":"基本详情","fetchedAtUtc":"2026-11-20T12:57:49.286046+00:00"},"warning":null}],"platformDetail":{"identity":{"facilityType":{"state":"missing","value":null,"observationCount":0},"starCode":{"state":"missing","value":null,"observationCount":0},"functionPositioning":{"state":"missing","value":null,"observationCount":0},"region":{"state":"missing","value":null,"observationCount":0},"address":{"state":"observed","value":"57号19栋二楼1-7单元、一楼梯间4-5单元","observationCount":1}},"tags":{"state":"observed","value":["民办","医养结合养老机构","内设医疗机构","与医疗机构签约合作","城区"],"observationCount":1},"subsidyCode":{"state":"observed","value":"1","observationCount":1},"contactName":{"state":"observed","value":"张敏","observationCount":1},"contactPhone":{"state":"observed","value":"15819429813","observationCount":1},"pointRaw":{"state":"observed","value":"113.53504,22.2208","observationCount":1},"photoCount":{"state":"observed","value":1,"observationCount":1},"areaSqm":{"state":"observed","value":980,"observationCount":1},"introduction":{"state":"observed","value":"珠海市香洲区爱晖护老院成立于2002年12月，占地面积二千多平方米，位于香洲区拱北街道港昌路132号，拥有130张床位，现入住老人110余名。根据老年人的需要，设有单人房、双人房、三人房、四人房。全新的酒店式设计装修，房间宽敞明亮，阳光充足，空气流畅，环境干净，为各位长者提供最佳的养老胜地。院内设有医务室，并在卫生局注册备案，配备心电监护仪、心电图机、电子制氧机、吸痰器、雾化器等多种医疗及健身康乐设施，聘请临床经验丰富的老年病专家及多年临床护理经验的护理师五名，以及40多名经过严格培训上岗的专业护理人员及多名管理人员，从生活照料、康复护理、精神慰藉、文体娱乐、医疗保健等为入住长者提供全方位的优质服务。在社区各界及港澳地区享有颇高声誉。 一直以来我们坚持“关怀备至，体贴入微”、“悉心照顾，无私奉献”的宗旨。发自内心的去爱护每一位老人，做一名优秀的护理人员，办一所出色的护老院，与时俱进地开创新世纪有中国特色的老年公益之路，就是本院全体工作人员今后为之奋斗的目标。","observationCount":1},"service":{"content":{"state":"observed","value":"核心基础服务 · 个人生活照料：协助穿衣、洗漱、进食、沐浴、如厕等。 · 膳食服务：提供营养餐食，考虑长者口味和禁忌。 · 卫生与环境：个人清洁、衣物换洗、居室打扫。 · 专业支持服务 · 健康管理：建立健康档案、日常监测、协助服药。 · 医疗康复：部分机构内设医务室或与医院合作，提供康复护理。 · 安全保护：24小时值班、紧急呼叫系统、适老化设施防跌倒。 · 精神文娱服务 · 文化娱乐：组织书法、手工、棋牌、健身等活动。 · 心理慰藉：日常沟通、陪伴、心理支持。 · 特色与延伸服务 · 医养结合：将医疗、康复深度融入日常照护。 · 认知症照护：针对认知障碍长者提供专业照护专区。 · 安宁服务：为临终长者提供关怀，减少痛苦。","observationCount":1},"team":{"state":"observed","value":"配备专业医疗团队，24小时专人护理","observationCount":1},"hours":{"state":"observed","value":"0:00-24:00","observationCount":1},"scope":{"state":"observed","value":"老人收养和护理","observationCount":1},"explanation":{"state":"observed","value":"1. 基本生活照料、起居照料、协助或代为完成起床、穿衣、洗漱、如厕、沐浴等。 膳食服务：提供营养均衡的一日三餐及点心，通常可据健康需求（如糖尿病、低盐）定制。 环境卫生：包括个人衣物换洗、床单位清洁及居住房间的日常打扫。 2. 专业健康管理：健康监测、定期测量记录血压、血糖、体温等，建立健康档案。 用药管理：提醒、协助或监督长者按时服药。 康复护理：可能包括简单的肢体功能锻炼、协助使用康复器械等。 医疗对接：协助联系医院、预约挂号、陪同就医（此项可能单独收费）。 3. 安全保障：安全设施、全楼无障碍设计、走廊扶手、防滑地板、24小时监控、床头紧急呼叫系统。 值班巡查：护理员定期房间巡查，应对夜间突发状况。 风险预防：对高风险长者进行防跌倒、防走失等专项看护。 4. 精神文娱与社交：文娱活动、组织书法、手工、棋牌、音乐、节庆活动、生日会等。 社交支持：创造公共活动空间，促进长者间的交流。","observationCount":1}},"beds":{"total":{"state":"observed","value":130,"observationCount":1},"dayCare":{"state":"observed","value":0,"observationCount":1},"fullCare":{"state":"observed","value":130,"observationCount":1},"nursing":{"state":"observed","value":0,"observationCount":1}},"feeSummary":[{"code":"04","label":"月总费用","range":{"state":"observed","value":[5800,8500],"observationCount":1},"description":{"state":"observed","value":"每月费用","observationCount":1}},{"code":"02","label":"床位费用","range":{"state":"observed","value":[2300,3900],"observationCount":1},"description":{"state":"observed","value":"每月费用","observationCount":1}},{"code":"01","label":"护理费用","range":{"state":"observed","value":[2400,3500],"observationCount":1},"description":{"state":"observed","value":"每月护理费用（包含日常起居、洗衣、喂养、服药等）","obs
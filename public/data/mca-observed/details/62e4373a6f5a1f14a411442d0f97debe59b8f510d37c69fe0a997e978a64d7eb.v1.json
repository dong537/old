ng":null},{"key":"listedMonthlyFeeMax","label":"月费用上限（平台列示）","text":"3,000 元/月","state":"observed","source":{"channelLabel":"基本详情","fetchedAtUtc":"2026-11-18T18:11:52.645394+00:00"},"warning":null},{"key":"platformStarCode","label":"机构星级原码（评定期未核）","text":"00","state":"observed","source":{"channelLabel":"平台列表","fetchedAtUtc":"2026-11-18T18:06:20.372025+00:00"},"warning":null},{"key":"evaluationCount","label":"平台评价次数","text":"0 次","state":"observed","source":{"channelLabel":"基本详情","fetchedAtUtc":"2026-11-18T18:11:52.645394+00:00"},"warning":null},{"key":"overallEvaluation","label":"平台综合评价原值","text":"暂无评价（原值为 0）","state":"observed","source":{"channelLabel":"基本详情","fetchedAtUtc":"2026-11-18T18:11:52.645394+00:00"},"warning":null},{"key":"functionPositioningLabel","label":"功能定位原标签","text":"原平台未提供","state":"missing","source":null,"warning":null},{"key":"platformTagsRaw","label":"平台标签原文（资格未核）","text":"民办,长护险定点机构,城区","state":"observed","source":{"channelLabel":"基本详情","fetchedAtUtc":"2026-11-18T18:11:52.645394+00:00"},"warning":null}],"platformDetail":{"identity":{"facilityType":{"state":"observed","value":"养老机构","observationCount":2},"starCode":{"state":"observed","value":"00","observationCount":2},"functionPositioning":{"state":"missing","value":null,"observationCount":0},"region":{"state":"observed","value":"河南省/开封市/杞县","observationCount":2},"address":{"state":"observed","value":"杞县金城大道中段路北","observationCount":2}},"tags":{"state":"observed","value":["民办","长护险定点机构","城区"],"observationCount":1},"subsidyCode":{"state":"observed","value":"1","observationCount":1},"contactName":{"state":"observed","value":"任排中","observationCount":1},"contactPhone":{"state":"observed","value":"18238218671","observationCount":1},"pointRaw":{"state":"observed","value":"114.77556,34.55046","observationCount":1},"photoCount":{"state":"observed","value":4,"observationCount":1},"areaSqm":{"state":"observed","value":1100,"observationCount":1},"introduction":{"state":"observed","value":"怡心苑老年公寓简介 我养老公寓是一家民办非企业养老护理机构，现有建筑面积 3100平方米。服务设施面积 1450平方米，养老床及护理床位共计 110张，有按摩床两张，按摩椅两个，另有一定数量的康复训练器材，训练之余还可以去阅览室看看书、看着报纸、练练书法，去娱乐室打打牌。 可以满足老年人康复训练及文化娱乐等的服务要求，再加上护工的精心护理，近一年来得到了入住老年人的好评及上级主管单位的多次表扬，家属及老人赠送4面锦旗，被评为河南省1星级养老机构。 我单位承诺近4年内从无违反法律法规，从未受倒行政处罚也没有重大事故发生。","observationCount":1},"service":{"content":{"state":"observed","value":"为入住老年人提供生活照料、膳食供应、医疗护理、精神慰藉、文化娱乐、安宁服务、 1. 生活照料：助餐、助浴、助洁、助行、穿衣修饰、口腔护理、排泄照料、起居照护、衣物洗涤、房间保洁。 2. 膳食服务：营养配餐、三餐供应、流食/软食定制、加餐服务、饮食禁忌适配、食品安全管控。 3. 医疗护理：健康监测、用药提醒、基础护理、压疮预防、等专项护理。 4.精神慰藉：心理疏导、亲情探访协助、生日关怀、节日慰问、情绪陪伴。 5.文化娱乐：棋牌书画，影视欣赏、健身锻炼。 6‘安全保障：24小时值班紧急呼叫响应，消防安全，防跌倒/防走失管理。","observationCount":1},"team":{"state":"observed","value":"我们机构建立了一支专业、稳定、具备丰富养老照护经验的服务团队，团队结构完善、岗位职责明确，能够为入住老年人提供高质量的生活照料、健康管理与精神关怀服务。 一、团队配置 •管理人员：设院长、副院长、财务、后勤主管等岗位，负责机构日常运营、安全管理与服务质量控制。 •专业护理团队：配备护理员、照护专员，按等级与照护等级配置，可实现自理、半失能、失能老人分层照护。 •膳食与后勤团队：专业厨师、保洁、安保等，确保三餐营养、环境整洁与园区安全。 二、服务理念 坚持“安全为先、尊重为本、科学照护、温暖陪伴”的服务理念，以专业、细致、有温度的服务提升老人生活品质。","observationCount":1},"hours":{"state":"observed","value":"本机构为老年人提供24小时全天候照护服务。夜间配备值班人员及应急响应机制，确保全天候、不间断照护与管理。","observationCount":1},"scope":{"state":"observed","value":"一，照护服务范围 1.生活照料：针对自理、半失能、失能及认知障碍（失智）老人，提供全面的日常生活起居照料。 2.健康医疗：提供常规健康体检、用药指导、基础医疗护理及紧急转诊协助。 3. 膳食供应：根据老人身体状况及饮食禁忌，提供营养均衡的三餐、加餐与特餐（如流食、软食）。 二、精神文化服务范围 1. 文娱活动：组织开展棋牌、书画、按摩椅、影视欣赏等各类文化娱乐活动。 2. 精神慰藉：提供心理疏导、亲情陪伴关怀及节日慰问，丰富」人精神生活。 3，膳食供应：根据老人身体状况及饮食禁忌，提供营养均衡的三餐，加餐与特餐（如流食，软食）。 三，配套保障服务范围 1，住宿环境：提供标准化及适老化住宿设施，保障居住安全与舒适。 2. 安全保障：实行24小时值班与应急响应机制，涵盖消防安全、防走失、防跌伤等全方位安全管理。","observationCount":1},"explanation":{"state":"observed","value":"本机构为入住老年人提供生活照料、健康医疗、康复保健、营养膳食、精神文化娱乐及 24小时安全保障等综合养老服务，坚持专业化、规范化、有温度的照护模式，全面提升老人生活质量。","observationCount":1}},"beds":{"total":{"state":"observed","value":110,"observationCount":1},"dayCare":{"state":"observed","value":0,"observationCount":1},"fullCare":{"state":"observed","value":110,"observationCount":1},"nursing":{"state":"observed","value":66,"observationCount":1}},"feeSummary":[{"code":"04","label":"月总费用","range":{"state":"observed","value":[1400,3000],"observationCount"
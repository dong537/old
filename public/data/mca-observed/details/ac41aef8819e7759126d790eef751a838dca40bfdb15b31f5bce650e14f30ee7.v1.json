ng":null},{"key":"listedMonthlyFeeMax","label":"月费用上限（平台列示）","text":"3,800 元/月","state":"observed","source":{"channelLabel":"基本详情","fetchedAtUtc":"2026-11-18T18:10:14.408294+00:00"},"warning":null},{"key":"platformStarCode","label":"机构星级原码（评定期未核）","text":"00","state":"observed","source":{"channelLabel":"平台列表","fetchedAtUtc":"2026-11-18T18:06:09.431584+00:00"},"warning":null},{"key":"evaluationCount","label":"平台评价次数","text":"0 次","state":"observed","source":{"channelLabel":"基本详情","fetchedAtUtc":"2026-11-18T18:10:14.408294+00:00"},"warning":null},{"key":"overallEvaluation","label":"平台综合评价原值","text":"暂无评价（原值为 0）","state":"observed","source":{"channelLabel":"基本详情","fetchedAtUtc":"2026-11-18T18:10:14.408294+00:00"},"warning":null},{"key":"functionPositioningLabel","label":"功能定位原标签","text":"原平台未提供","state":"missing","source":null,"warning":null},{"key":"platformTagsRaw","label":"平台标签原文（资格未核）","text":"民办,城区","state":"observed","source":{"channelLabel":"基本详情","fetchedAtUtc":"2026-11-18T18:10:14.408294+00:00"},"warning":null}],"platformDetail":{"identity":{"facilityType":{"state":"observed","value":"养老机构","observationCount":2},"starCode":{"state":"observed","value":"00","observationCount":2},"functionPositioning":{"state":"missing","value":null,"observationCount":0},"region":{"state":"observed","value":"河南省/开封市/杞县","observationCount":2},"address":{"state":"observed","value":"杞县南环路东段路北","observationCount":2}},"tags":{"state":"observed","value":["民办","城区"],"observationCount":1},"subsidyCode":{"state":"observed","value":"1","observationCount":1},"contactName":{"state":"observed","value":"吕恒梅","observationCount":1},"contactPhone":{"state":"observed","value":"15137872416","observationCount":1},"pointRaw":{"state":"observed","value":"114.77858,34.53853","observationCount":1},"photoCount":{"state":"observed","value":3,"observationCount":1},"areaSqm":{"state":"observed","value":1700,"observationCount":1},"introduction":{"state":"observed","value":"河南省杞县金三角老年休养中心是为老年人提供专业化居住、护理及社交服务的综合性养老机构，建筑面积1000平方米，实用面积32亩，介于传统家庭养老与医疗机构之间，主要面向生活能自理或半自理的老年群体。我们秉承“以人为本，关爱老人”的服务理念，通过专业的护理团队和丰富的文化活动，为长者打造一个充满爱与关怀的家园。","observationCount":1},"service":{"content":{"state":"observed","value":"居住服务：提供单人间、双人间等多种房型选择，房间内配备空调、电扇、洗漱间等生活设施。同时，公共区域设有餐厅、休闲室、健身区等，满足长者的日常需求。 护理服务：拥有一支经过专业培训的护理团队，提供24小时全天候护理服务。根据长者的身体状况和需求，制定个性化的护理计划，包括日常照料、健康监测、药物管理等。 文化娱乐：组织丰富多彩的文化娱乐活动，丰富长者的精神生活，促进身心健康。 心理关怀：提供专业的心理辅导服务，帮助长者解决心理问题。","observationCount":1},"team":{"state":"observed","value":"服务团队由护理团队和营养规划团队组成。护理团队由专业护理员，提供24小时生活照料、健康监测及个性化康复服务。团队均经过系统培训，掌握老年护理技能，兼顾老人身心健康，确保安全、舒适、有尊严的晚年生活。营养规划团队是经验厨师擅长定制低盐、低糖、易消化的适老化营养餐。注重食材新鲜与膳食均衡，根据老人健康状况及口味偏好提供个性化餐饮服务，同时严格把控食品安全卫生，确保长者吃得健康、美味、舒心。","observationCount":1},"hours":{"state":"observed","value":"河南省杞县金三角老年休养中心从2013年7月建院以来，服务时间为24小时全天候响应，日常照护、餐饮及娱乐活动按作息表定时提供，紧急呼叫系统随时待命，护理团队昼夜轮岗，确保长者任何时候都能获得及时、专业的服务。","observationCount":1},"scope":{"state":"observed","value":"入院评估：养老机构应当建立入院评估制度，对老年人的身体状况进行评估。 医疗康复服务：为老年人建立健康档案，开展日常保健知识宣传，做好疾病预防工作。在老年人突发危重疾病时，应当转送医疗机构救治并及时通知其代理人或者紧急联系人。 生活照料服务：提供满足老年人日常生活需求的吃饭、穿衣、如厕、洗澡、室内外活动等服务。 精神卫生服务：养老机构发现老年人为精神病人或者疑似精神病人的，实施专区管理，并及时通知其代理人或者紧急联系人，并向医疗机构报告，配合实施管控处理、隔离等预防控制措施。","observationCount":1},"explanation":{"state":"observed","value":"我们始终坚持以长者为中心的服务理念，尊重每一位长者的个性和需求。通过细心呵护和真诚陪伴，让长者感受到家的温暖和关怀。我们相信，只有用心服务，才能让长者真正享受到幸福的晚年生活。未来，我们将继续秉持“以人为本，关爱老人”的服务理念，不断提升服务质量和管理水平。同时，加强与社会各界的合作与交流，共同推动养老事业的发展。我们相信，在大家的共同努力下，我们的老年修养中心将成为更多长者的理想之选。","observationCount":1}},"beds":{"total":{"state":"observed","value":60,"observationCount":1},"dayCare":{"state":"observed","value":4,"observationCount":1},"fullCare":{"state":"observed","value":56,"observationCount":1},"nursing":{"state":"observed","value":50,"observationCount":1}},"feeSummary":[{"code":"04","label":"月总费用","range":{"state":"observed","value":[1000,3800],"observationCount":1},"description":{"state":"observed","value":"包含护理费、床位费和膳食费。","observationCount":1}},{"code":"02","label":"床位费用","range":{"state":"observed","value":[400,800],"observationCount":1},"description":{"state":"observed","value":"大包间800元/月；小包间600元/月；双人间400元/月。","observationCount":1}},{"code":"01","label":"护理费用","range":{"state":"observed","value":[200,2500],"observationCount":1},"description":{"state":"observed","value":"打扫卫生、送开水、洗衣服、送饭、洗碗、端茶倒水、服药、穿脱衣服、帮助大小便、更换尿不湿、助行、助洁、上下轮椅、移位、喂饭、翻身、拍背、量血压、剪指甲、擦洗身子、理发、陪护看护等。","observationCount":1}},{"code":"03","label":"膳食费用","range":{"state":"observed","value":[400,500],"observationCount":1},"description":{"state":"observed","value":"一日三餐。","observationCount":1}}],"charges":{"state":"observed","value":[{"id":"00ef4413d90e4d47a2ea9739230c0747","name":"养老服务","description":"自理老人:为老人提供住宿、餐饮、洗衣服、打扫房间卫生、送开水等。半自理老人:1.进食:送饭、洗碗。2.穿衣:帮忙穿脱衣服整理衣服、3:洗澡、帮忙搀扶、助浴。4.如厕:需要搀扶、帮忙擦、处理失禁。5.床椅转移:需要人扶、抱、拉一把。6.平地行走:需要拐杖、搀扶、走不动。全失能老人服务范围：在半自理老人日常护理参础上，提供喂水、喂药、喂饭、穿脱衣服、翻身拍背、更换体位、擦洗身体、臀部清洁、防褥疮护理、使用便盆、尿壶、纸尿裤更换、清洁，陪伴聊天、兴许疏导、定时锻炼及看护服务。","standard":"1000—3800元/月"}],"observationCount":1},"subServices":{"respite":{"beds":{"state":"missing","value":null,"observationCount":0},"nursingBeds":{"state":"missing","value":null,"observationCount":0},"fee":{"state":"missing","value":null,"observationCount":0},"unit":"元/天","project":{"state":"missing","value":null,"observationCount":0},"charges":{"state":"missing","value":null,"observationCount":0}},"dayCare":{"beds":{"state":"missing","value":null,"observationCount":0},"nursingBeds":{"state":"missing","value":null,"observationCount":0},"fee":{"state":"missing","value":null,"observationCount":0},"unit":"元/天","project":{"state":"missing","value":null,"observationCount":0},"charges":{"state":"missing","value":null,"observationCount":0}},"homeVisit":{"beds":{"state":"missing","value":null,"observationCount":0},"nursingBeds":{"state":"missing","value":null,"observationCount":0},"fee":{"state":"missing","value":null,"observationCount":0},"unit":"元/次","project":{"state":"missing","value":null,"observationCount":0},"charges":{"state":"missing","value":null,"observationCount":0}},"assessment":{"home":{"state":"missing","value":null,"observationCount":0},"site":{"state":"missing","value":null,"observationCount":0}}},"evaluation":{"state":"observed","text":"暂无平台评价","count":{"state":"observed","value":0,"observationCount":2},"score":{"state":"observed","value":0,"observationCount":2}}},"conflictLabels":[],"detailObservedAtUtc":{"earliest":"2026-11-18T18:10:14.408294+00:00","latest":"2026-11-18T18:10:27.432854+00:00"}}

te":"observed","value":"上海闵行区继王敬老院是一家非营利性民办性质的养老机构，始建于2009年3月。位于闵行区华漕镇纪王集镇中心，全院占地面积4，650㎡，建筑面积6，798㎡，核定床位271张。房型多样，设施齐全，环境优雅，交通便利，医养结合，服务专业。","observationCount":1},"service":{"content":{"state":"observed","value":"日常照护、清洁卫生、预防保健、社交娱乐、精神支持","observationCount":1},"team":{"state":"observed","value":"总员工 86人, 管理岗位 11人, 专业技术岗位医生3人，护士3人，社工2人，护理员岗位 49 人, 后勤岗位18人","observationCount":1},"hours":{"state":"observed","value":"24小时","observationCount":1},"scope":{"state":"observed","value":"根据老人身体状况提供相应等级的护理服务，对生活完全不能自理及长期卧床的老人可提供专业照护。日常照护内容包括进食、修饰、洗浴、穿脱衣、排泄如厕、移动、压疮护理、物品整理、巡视、洗涤等。","observationCount":1},"explanation":{"state":"observed","value":"继王秉持“让失能失智老人的人生闭幕式更精彩”的使命，坚持“诚信、凝聚、感恩、精细、奋进”的价值观，践行“大爱温暖社会，管理创造能量”的服务宗旨，在定位上，继王以收养有医疗需求的失能失智老人为主，解决养老家庭的刚性需求。从“医、养、学、乐”四个方面提供科学化和亲情般的服务，为老年人提供全方位的生活护理及医疗护理等服务。","observationCount":1}},"beds":{"total":{"state":"observed","value":271,"observationCount":1},"dayCare":{"state":"observed","value":0,"observationCount":1},"fullCare":{"state":"observed","value":271,"observationCount":1},"nursing":{"state":"observed","value":150,"observationCount":1}},"feeSummary":[{"code":"04","label":"月总费用","range":{"state":"observed","value":[3840,5640],"observationCount":1},"description":{"state":"observed","value":"床位费、护理费、伙食费","observationCount":1}},{"code":"02","label":"床位费用","range":{"state":"observed","value":[1500,2550],"observationCount":1},"description":{"state":"observed","value":"床位费","observationCount":1}},{"code":"01","label":"护理费用","range":{"state":"observed","value":[1590,2340],"observationCount":1},"description":{"state":"observed","value":"护理费","observationCount":1}},{"code":"03","label":"膳食费用","range":{"state":"observed","value":[750,750],"observationCount":1},"description":{"state":"observed","value":"膳食费","observationCount":1}}],"charges":{"state":"observed","value":[{"id":"180d72a3ef5a4cb0b60ac240e0b3da57","name":"床位费","description":"床位费","standard":"1500-2550元/月"},{"id":"c7708b9345854fbd8eb67571de4f1086","name":"护理费","description":"护理费","s
:00"},"warning":null},{"key":"listedMonthlyFeeMax","label":"月费用上限（平台列示）","text":"7,300 元/月","state":"observed","source":{"channelLabel":"基本详情","fetchedAtUtc":"2026-11-19T11:44:33.646874+00:00"},"warning":null},{"key":"platformStarCode","label":"机构星级原码（评定期未核）","text":"00","state":"observed","source":{"channelLabel":"平台列表","fetchedAtUtc":"2026-11-19T08:38:41.471994+00:00"},"warning":null},{"key":"evaluationCount","label":"平台评价次数","text":"0 次","state":"observed","source":{"channelLabel":"基本详情","fetchedAtUtc":"2026-11-19T11:44:33.646874+00:00"},"warning":null},{"key":"overallEvaluation","label":"平台综合评价原值","text":"暂无评价（原值为 0）","state":"observed","source":{"channelLabel":"基本详情","fetchedAtUtc":"2026-11-19T11:44:33.646874+00:00"},"warning":null},{"key":"functionPositioningLabel","label":"功能定位原标签","text":"原平台未提供","state":"missing","source":null,"warning":null},{"key":"platformTagsRaw","label":"平台标签原文（资格未核）","text":"公办,医养结合养老机构,与医疗机构签约合作,城区","state":"observed","source":{"channelLabel":"基本详情","fetchedAtUtc":"2026-11-19T11:44:33.646874+00:00"},"warning":null}],"platformDetail":{"identity":{"facilityType":{"state":"observed","value":"养老机构","observationCount":3},"starCode":{"state":"observed","value":"00","observationCount":3},"functionPositioning":{"state":"missing","value":null,"observationCount":0},"region":{"state":"observed","value":"河北省/石家庄市","observationCount":3},"address":{"state":"observed","value":"河北省石家庄市长安区高营镇北高营村蓝月路6号","observationCount":3}},"tags":{"state":"observed","value":["公办","医养结合养老机构","与医疗机构签约合作","城区"],"observationCount":1},"subsidyCode":{"state":"observed","value":"1","observationCount":1},"contactName":{"state":"observed","value":"王朝","observationCount":1},"contactPhone":{"state":"observed","value":"13303312502","observationCount":1},"pointRaw":{"state":"observed","value":"114.55197,38.11071","observationCount":1},"photoCount":{"state":"observed","value":10,"observationCount":1},"areaSqm":{"state":"observed","value":50887,"observationCount":1},"introduction":{"state":"observed","value":"石家庄市养老院成立于2013年5月，位于长安区太平河河畔，是石家庄市政府投资建设的公益性、非盈利性养老机构。该养护院是集住宿、办公、康复、娱乐于一体的疗养中心，建筑面积3万平米，总投资1.4亿元。现有主体楼4栋，其中养护楼3栋，床位660张。综合楼为综合服务区和设备运行区，设有食堂、康复中心、多功能厅、培训中心、监控中心、办公室、设备房等；养护楼为颐养和护理两个功能区。每个房间均设有独立卫生洗浴间、有线电视、无线网络、起居室、阳台。楼内每层都设有值班室、活动室、备餐间、餐厅、治疗室、监控室等。中心活动区设有书画室、阅览室、健身室、棋牌室、桌球室和多功能厅等活动空间，配有书法绘画用具、各类图书、健身器材、多种棋牌等设施，并建有全程无障碍通道及无障碍设施。石家庄市养老院荣获河北省首家“全国养老机构标准化建设试点单位”称号和国家老龄委授予的“敬老文明号”先进单位称号；被中国社会福利与养老服务协会聘为“医养结合分会理事单位”；荣获石家庄市安全生产委员会授予的“2016年度安全生产管理先进单位”等多项荣誉。","observationCount":1},"service":{"content":{"state":"observed","value":"生活照料服务 这是养老院的基础服务，适配不同自理能力的老人： 自理老人：提供整洁的居住环境（房间清洁、床品换洗）、公共区域维护，协助收发物品、代办生活琐事，组织日常起居相关的提醒服务（如作息、用药提醒）。 半自理老人：增加穿衣、洗漱、如厕、上下床的协助，定期修剪指甲、理发、剃须，陪同散步等轻度活动。 失能 / 卧床老人：提供全方位照护，包括定时翻身、拍背预防压疮，鼻饲护理、导尿管护理，口腔清洁、皮肤护理等专业生活照料。 膳食营养服务 结合老人身体需求定制饮食方案： 提供一日三餐及加餐，根据老人健康状况调整膳食，比如糖尿病老人的低糖餐、高血压老人的低盐餐、吞咽困难老人的流食 / 半流食。 尊重老人的饮食偏好和宗教禁忌，定期更换菜单，保证营养均衡、食材新鲜。 精神文化与社交服务 避免老人孤独，丰富精神生活： 文化娱乐：组织书法、绘画、唱歌、棋牌、观影等活动，配备阅览室、棋牌室、活动室等场地。 社交互动：举办节日庆典、生日会、家属联谊活动，鼓励老人之间交流，减少孤独感。 心理疏导：配备心理咨询师或社工，为有需求的老人提供情绪疏导，缓解焦虑、抑郁等心理问题","observationCount":1},"team":{"state":"observed","value":"拥有养老照料护理团队及居家上门护理员，中式厨师、社工师、由资深医护人员、康复师、营养师、心理咨询师及专职护理员组成，全部持证上岗并接受常态化培训。","observationCount":1},"hours":{"state":"observed","value":"全年无休7*24小时","observationCount":1},"scope":{"state":"observed","value":"生活照料服务：起居照料协助穿衣卧床瘫痪老人护理代订代购房间清洁消毒 营养膳食服务：适老化餐 文化娱乐服务：书画阅览 康复训练服务：术后康复认知训练 居家上门服务：仅限石家庄市长安区体育北大街","observationCount":1},"explanation":{"state":"observed","value":"护理服务实行24小时轮班制，针对失能、半失能长者提供个性化照护方案，包括翻身拍背、助浴助行、用药管理等专业服务。膳食方面，营养团队根据长者健康状况定制低盐低脂、软烂易消化的餐食，并设有特殊饮食窗口。此外，社工团队通过节日庆典、生日会、外出参观等活动，增强长者的社会参与感与幸福感。","observationCount":1}},"beds":{"total":{"state":"observed","value":1090,"observationCount":1},"dayCare":{"state":"observed","value":40,"observationCount":1},"fullCare":{"state":"observed","value":1050,"observationCount":1},"nursing":{"state":"observed","value":1090,"observationCount":1}},"feeSummary":[{"code":"04","label":"月总费用","range":{"state":"observed","value":[2150,7300],"observationCount":1},"description":{"state":"observed","value":"自理老人为2150元","observationCount":1}},{"code":"02","label":"床位费用","range":{"state":"observed","value":[1350,3600],"observationCount":1},"description":{"state":"observed","value":"双人间，套间单人，套间夫妻","observationCount":1}},{"code":"01","label":"护理费用","range":{"state":"observed","value":[300,2500],"observationCount":1},"description":{"state":"observed","value":"介助，介护，特护专护","observationCount":1}},{"code":"03","label":"膳食费用","range":{"state":"observed","value":[600,1200],"observationCount":1},"description":{"state":"observed","value":"营养餐，自助餐","observationCount":1}}],"charges":{"state":"observed","value":[{"id":"203f5e756d3644c79262d6c34f8334db","name":"一区介护","description":"中度至重度失能","standard":"750-1050元/月"},{"id":"dd3624cd69af47bf861d45cf5f84091d","name":"一区特护","description":"重度失能至完全失能","standard":"2500元/月"},{"id":"d7cfd409a5ac497b800edf8c4baa9e93","name":"一区专护","description":"一对一专护","standard":"4000-8000元/月"},{"id":"f6a13a7e4c1b4d7ca2148fc49c59323b","name":"一区介助","description":"部分自理老人护理","standard":"300-450元/月"},{"id":"9a39076090244e7a8cca25c2ca0426af","name":"一区基础服务费","description":"水费、电费、打扫卫生费、 电视费、公共设施、器材使用费等","standard":"200元/月/人"},{"id":"4a82a3f409604db5abd22b31f342e582","name":"一区套间夫妻","description":"甲等房：床位费5650元/月/套 乙等房：床位费5200元/月/套（包括基础服务费、餐费）","standard":"5200-5650元/月/人"},{"id":"e5f8455f0dbc4830bcb4017115dac931","name":"一区双人间楼层费","description":"一层60元/月/人 二三层30元/月/人 四层以上无楼层费","standard":"30-60元/月/人"},{"id":"71a325fb07654ea48f405b9835bf90b6","name":"一区套间楼层费","description":"一层120元/月/人 二三层90元/月/人 四层以上无楼层费","standard":"90-120元/月/人"},{"id":"905e4d1354964bf296cb185643d572b0","name":"一区双人间","description":"甲等房：床位费2450元/月/人 乙等房：床位费2150元/月/人（包括基础服务费、餐费）","standard":"2150-2450元/月/人"},{"id":"a723f20856b54690aaa7a3efd247a1fc","name":"一区套间单人","description":"甲等房：床位费4850元/月/套 乙等房：床位费4400元/月/套（包括基础服务费、餐费）","standard":"4400-4850元/月/人"}],"observationCount":1},"evaluation":{"state":"observed","text":"暂无平台评价","count":{"state":"observed
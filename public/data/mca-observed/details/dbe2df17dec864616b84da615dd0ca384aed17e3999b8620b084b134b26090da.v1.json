warning":null},{"key":"listedMonthlyFeeMax","label":"月费用上限（平台列示）","text":"7,400 元/月","state":"observed","source":{"channelLabel":"基本详情","fetchedAtUtc":"2026-11-18T17:59:28.538649+00:00"},"warning":null},{"key":"platformStarCode","label":"机构星级原码（评定期未核）","text":"02","state":"observed","source":{"channelLabel":"平台列表","fetchedAtUtc":"2026-11-20T10:23:38.786666+00:00"},"warning":null},{"key":"evaluationCount","label":"平台评价次数","text":"0 次","state":"observed","source":{"channelLabel":"基本详情","fetchedAtUtc":"2026-11-18T17:59:28.538649+00:00"},"warning":null},{"key":"overallEvaluation","label":"平台综合评价原值","text":"暂无评价（原值为 0）","state":"observed","source":{"channelLabel":"基本详情","fetchedAtUtc":"2026-11-18T17:59:28.538649+00:00"},"warning":null},{"key":"functionPositioningLabel","label":"功能定位原标签","text":"原平台未提供","state":"missing","source":null,"warning":null},{"key":"platformTagsRaw","label":"平台标签原文（资格未核）","text":"公建民营,医养结合养老机构,内设医疗机构,与医疗机构签约合作,城区","state":"observed","source":{"channelLabel":"基本详情","fetchedAtUtc":"2026-11-18T17:59:28.538649+00:00"},"warning":null}],"platformDetail":{"identity":{"facilityType":{"state":"observed","value":"养老机构","observationCount":4},"starCode":{"state":"observed","value":"02","observationCount":4},"functionPositioning":{"state":"missing","value":null,"observationCount":0},"region":{"state":"observed","value":"北京市/东城区","observationCount":4},"address":{"state":"observed","value":"北京市东城区西草市东街60号","observationCount":4}},"tags":{"state":"observed","value":["公建民营","医养结合养老机构","内设医疗机构","与医疗机构签约合作","城区"],"observationCount":1},"subsidyCode":{"state":"observed","value":"1","observationCount":1},"contactName":{"state":"observed","value":"陈文杰","observationCount":1},"contactPhone":{"state":"observed","value":"18232648054","observationCount":1},"pointRaw":{"state":"observed","value":"116.39334,39.88788","observationCount":1},"photoCount":{"state":"observed","value":7,"observationCount":1},"areaSqm":{"state":"observed","value":1022,"observationCount":1},"introduction":{"state":"observed","value":"北京市东城区天坛兆如老年养护中心成立于2016年，坐落于西草市东街60号，毗邻天坛公园，周边环绕着前门、大栅栏、天安门等历史文化地标。中心建筑面积1022平方米，主要接收自理、半自理及失能长者，为其提供全方位、专业化的养老服务。 中心集生活照料、医疗护理、文化娱乐等功能于一体，内设医务室，并与多家三甲医院建立合作，开通绿色就医通道，实现“医养结合”无缝衔接。院内配备电梯和适老化无障碍设施，确保长者生活安全便利。此外，中心定期开展保健操、书法、手工等文娱活动，丰富长者的精神文化生活，营造温馨、安康的养老氛围。","observationCount":1},"service":{"content":{"state":"observed","value":"优势特点 中心致力于打造“离家不离圈”的养老生活，让长者无需远离熟悉的胡同、老邻居和原有生活圈子，即可享受专业照护。这种“入住即归家”的模式，极大地缓解了长者的适应压力，使其在熟悉的环境中保持生活的亲切感与幸福感，也极大方便了子女亲朋日常探视，亲情陪伴触手可及，温暖常在。 环境设施 中心全部采用环保无害材料，居室均配备独立卫生间、国家标准的专业护理床、智能感应夜灯、防滑地板及全屋无障碍设计，细节处彰显用心。中心还设有餐厅、文化娱乐室、医疗室、心理慰藉室等多元空间，全面保障长者的生活便利与身心舒适。 服务特色 作为具备医疗资质的专业养老机构，院内设有医务室，可便捷处理长者日常健康问题，并提供系统的慢性病管理。同时，中心与多家三甲医院开通绿色转诊通道，全面守护长者健康。 在文娱生活方面，中心定期开展保健操、书法、唱歌、手工、读书会等多样化活动，并积极联动志愿者与社工团队，组织节日庆典、主题慰问与社交陪伴，满足长者的精神文化需求，营造温暖、活力的社区氛围。 居家辐射服务: 助医、助行、助洁、助餐、助浴、助急、信息管理服务、教育培训服","observationCount":1},"team":{"state":"observed","value":"护理团队 医疗团队 餐饮团队","observationCount":1},"hours":{"state":"observed","value":"8：30--12：00 14：00---16：30","observationCount":1},"scope":{"state":"observed","value":"个人生活照料服务,老年护理服务,心理/精神支持服务,安全保护服务,环境卫生服务,休闲娱乐服务,协助医疗护理服务,医疗保健服务,居家生活照料服务,膳食服务,洗衣服务,物业管理维修服务,陪同就医服务,咨询服务,通讯服务,送餐服务,教育服务,购物服务,委托服务,交通服务,安宁服务。总之，东城区天坛兆如老年养护中心以其专业的服务、优雅的环境、全面的设施配置以及丰富的特色活动，为老年人打造了一个理想的养老家园。在这里，老年人不仅能享受到专业的医疗照护和生活照料，还能感受到家一般的温暖和社会的关怀。","observationCount":1},"explanation":{"state":"observed","value":"一、基础生活照料服务 日常起居协助 包括穿衣、进食、洗漱、如厕、翻身、转移等个性化护理，根据老人自理能力分级提供帮助。 对失能、半失能老人提供卧床护理、代订代购、房间清洁消毒等服务。 专业护理支持 配备持证护理团队，提供伤口护理、导管护理（如导尿管）、压疮预防等专业服务。 针对失智老人提供一对一或二对一专护，确保安全与情绪稳定。 二、医疗与健康管理 内设医务室，提供慢病管理、用药指导、康复训练等医疗服务。 与隆福医院及天坛街道卫生服务中心等医院合作，开通绿色就医通道，紧急情况可快速转诊。 智能健康监测 使用智能床垫实时监测老人心率、呼吸、离床、睡眠等数据。 三、营养膳食与个性化餐食 由专业营养师团队定制食谱，提供适老化餐（如低糖、低脂、高纤维餐）、糖尿病餐、节日加餐及生日餐。 膳食注重荤素搭配、营养均衡，满足不同健康状况老人的需求。 四、环境与设施 四合院式居住环境：融合传统胡同文化与现代适老化设计，设有独立卫生间、防滑地板、无障碍设施及紧急呼叫系统。 多功能活动空间：配备阅览室、书画室、棋牌室等，满足老人文化娱乐需求。","observationCount":1}},"beds":{"total":{"state":"observed","value":57,"observationCount":1},"dayCare":{"state":"observed","value":0,"observationCount":1},"fullCare":{"state":"observed","value":57,"observationCount":1},"nursing":{"state":"observed","value":57,"observationCount":1}},"feeSummary":[{"code":"04","label":"月总费用","range":{"state":"observed","value":[5400,7400],"observationCount":1},"description":{"state":"observed","value":"按月收费","observationCount":1}},{"code":"02","label":"床位费用","range":{"state":"observed","value":[2100,2600],"observationCount":1},"description":{"state":"observed","value":"按照房屋朝向","observationCount":1}},{"code":"01","label":"护理费用","range":{"state":"observed","value":[2000,3500],"observationCount":1},"description":{"state":"observed","value":"按照老年人生活能力评估，确认护理级别","observationCount":1}},{"code":"03","label":"膳食费用","range":{"state":"observed","value":[1300,1300],"observationCount":1},"description":{"state":"observed","value":"统一定价","observationCount":1}}],"charges":{"state":"observed","value":[{"id":"5185ee7e74bc41ddb5b20d37a24d6dca","name":"护理费","description":"按照护理级别收费","standard":"2000元--3500元/月"},{"id":"c91b0517ac02488cb7a9e759fe97a02b","name":"餐饮费","description":"月缴费","standard":"1300元/月"},{"id":"88caf6c89e134992aebf008c3db4e73a","name":"床位费","description":"房屋朝向","standard":"2100--2600/月"}],"observationCount":1},"evaluation":{"state":"observed","text":"暂无平台评价","count":{"state":"observed","value":0,"observationCount":4},"score":{"state":"observed","value":0,"observationCount":4}}},"conflictLabels":[],"detailObservedAtUtc":{"earliest":"2026-11-18T17:59:28.538649+00:00","latest":"2026-11-18T17:59:42.128106+00:00"}}

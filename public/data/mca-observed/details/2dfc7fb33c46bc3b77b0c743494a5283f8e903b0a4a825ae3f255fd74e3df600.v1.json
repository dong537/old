{"schemaVersion":1,"snapshotId":"observed-4f69d0484f5c26b1d8e27798","mcaId":"019b334800d2487dae0abf05ec7a4b5c","sourcePage":"https://yanglao.mca.gov.cn/?#/index/orgServicesDetail?axbe0001=019b334800d2487dae0abf05ec7a4b5c&parentRoute=institutionList&tagValue=3","facts":[{"key":"name","label":"机构名称","text":"银川市兴庆区幸福里养老中心","state":"observed","source":{"channelLabel":"基本详情","fetchedAtUtc":"2026-11-19T10:48:02.927260+00:00"},"warning":null},{"key":"facilityTypeCode","label":"设施类型原码","text":"1","state":"observed","source":{"channelLabel":"平台列表","fetchedAtUtc":"2026-11-19T07:03:48.023528+00:00"},"warning":null},{"key":"facilityTypeLabel","label":"设施类型原标签","text":"养老机构","state":"observed","source":{"channelLabel":"平台列表","fetchedAtUtc":"2026-11-19T07:03:48.023528+00:00"},"warning":null},{"key":"areaCode","label":"地区代码","text":"640104000000","state":"observed","source":{"channelLabel":"基本详情","fetchedAtUtc":"2026-11-19T10:48:02.927260+00:00"},"warning":null},{"key":"regionLabel","label":"地区名称","text":"宁夏回族自治区银川市兴庆区","state":"observed","source":{"channelLabel":"平台列表","fetchedAtUtc":"2026-11-19T07:03:48.023528+00:00"},"warning":null},{"key":"regionPath","label":"地区层级","text":"宁夏回族自治区/银川市/兴庆区","state":"observed","source":{"channelLabel":"平台列表","fetchedAtUtc":"2026-11-19T07:03:48.023528+00:00"},"warning":null},{"key":"address","label":"详细地址","text":"北安小区49号楼、50号楼1.2.3层商业房","state":"observed","source":{"channelLabel":"基本详情","fetchedAtUtc":"2026-11-19T10:48:02.927260+00:00"},"warning":null},{"key":"listedBeds","label":"机构床位（平台列示）","text":"70 个","state":"observed","source":{"channelLabel":"养老详情","fetchedAtUtc":"2026-11-19T10:49:05.213893+00:00"},"warning":null},{"key":"nursingBeds","label":"护理型床位（平台列示）","text":"70 个","state":"observed","source":{"channelLabel":"养老详情","fetchedAtUtc":"2026-11-19T10:49:05.213893+00:00"},"warning":null},{"key":"listedMonthlyFeeMin","label":"月费用下限（平台列示）","text":"4,080 元/月","state":"observed","source":{"channelLabel":"基本详情","fetchedAtUtc":"2026-11-19T10:48:02.927260+00:00"},"warning":null},{"key":"listedMonthlyFeeMax","label":"月费用上限（平台列示）","text":"7,580 元/月","state":"observed","source":{"channelLabel":"基本详情","fetchedAtUtc":"2026-11-19T10:48:02.927260+00:00"},"warning":null},{"key":"platformStarCode","label":"机构星级原码（评定期未核）","text":"00","state":"observed","source":{"channelLabel":"平台列表","fetchedAtUtc":"2026-11-19T07:03:48.023528+00:00"},"warning":null},{"key":"evaluationCount","label":"平台评价次数","text":"0 次","state":"observed","source":{"channelLabel":"基本详情","fetchedAtUtc":"2026-11-19T10:48:02.927260+00:00"},"warning":null},{"key":"overallEvaluation","label":"平台综合评价原值","text":"暂无评价（原值为 0）","state":"observed","source":{"channelLabel":"基本详情","fetchedAtUtc":"2026-11-19T10:48:02.927260+00:00"},"warning":null},{"key":"functionPositioningLabel","label":"功能定位原标签","text":"专业照护,服务转介,资源链接,探访关爱,家庭支持,其他服务","state":"observed","source":{"channelLabel":"基本详情","fetchedAtUtc":"2026-11-19T10:48:02.927260+00:00"},"warning":null},{"key":"platformTagsRaw","label":"平台标签原文（资格未核）","text":"民办,城区","state":"observed","source":{"channelLabel":"基本详情","fetchedAtUtc":"2026-11-19T10:48:02.927260+00:00"},"warning":null}],"platformDetail":{"identity":{"facilityType":{"state":"observed","value":"养老机构","observationCount":2},"starCode":{"state":"observed","value":"00","observationCount":2},"functionPositioning":{"state":"observed","value":"专业照护,服务转介,资源链接,探访关爱,家庭支持,其他服务","observationCount":2},"region":{"state":"observed","value":"宁夏回族自治区/银川市/兴庆区","observationCount":2},"address":{"state":"observed","value":"北安小区49号楼、50号楼1.2.3层商业房","observationCount":2}},"tags":{"state":"observed","value":["民办","城区"],"observationCount":1},"subsidyCode":{"state":"observed","value":"1","observationCount":1},"contactName":{"state":"observed","value":"田晓琳","observationCount":1},"contactPhone":{"state":"observed","value":"13369510951","observationCount":1},"pointRaw":{"state":"observed","value":"106.255,38.4862","observationCount":1},"photoCount":{"state":"observed","value":8,"observationCount":1},"areaSqm":{"state":"observed","value":2780,"observationCount":1},"introduction":{"state":"observed","value":"银川市兴庆区幸福里是宁夏中房养老旗下的社区“嵌入式”养老机构之一，是以社区“嵌入式”养老机构连锁运营为发展方向，融合居机家养老与社区养老为一体，为社区失能、失智、高龄等长者，提供长期照护、短期看护、喘息服务、医疗护理、康复理疗、心理慰藉、营养膳食及文娱活动等服务，让长者享受有尊严、有温度、有品质的养老生活。机构于2019年12月投入运营，位于银川市兴庆区西桥巷(原阳澄巷)北安小区西门148号中房幸福里北安康养中心，建筑面积2780平方米，设有养老床位70张。机构内设置单人间、双人间、豪华双人间、四人套间，其中:一层为活动区、功能区、护理站；二层为失能、半失能长者生活区及相关配套区等、三层为自理长者生活区及相关配套区等，四层设屋顶花园为长者提供散步、休闲、晒太阳的舒适空间。2022年荣获国家民政部“全国养老服务先进单位”称号，2023年被评为自治区三星级养老服务机构。机构的核心理念是“在儿女身边养老”、“在家门口养老”，产品定位是专业化护理型康养中心。","observationCount":1},"service":{"content":{"state":"observed","value":"机构提供生活照料、膳食供应、康复保健、休闲娱乐、精神文化、教育咨询等服务，同是配备助浴、陪诊、陪护、养老评估等居家服务。为长者提供全方位、专业化、个性化和差异化的养老照护与生活支持。","observationCount":1},"team":{"state":"observed","value":"在岗员工28位，同时配备“八师团队”。其中机构院长为部队医院退役军人，副主任护师，一线护理团队均为养老、医疗相关专业院校毕业，平均年龄为25岁，持养老护理员初级证率100%，中级、高级证：94%，护士资格证：45%，老年人评估师5名，健康管理师1人，厨师、电梯及消防特种设备专业人员持证在岗，项目整体围绕“营造活力，全龄生活”的概念，为长者提供介托养护、日间照料、家庭养老以及文化养老四大主题单元。","observationCount":1},"hours":{"state":"observed","value":"24小时全年无休，提供日间照料、术后康复。喘息服务及长期照护。","observationCount":1},"scope":{"state":"observed","value":"根据国标要求，不收住传染病及精神疾病老人，其余自理、失能、失智长者等多种类型老人均为服务对象。","observationCount":1},"explanation":{"state":"observed","value":"机构内设护理站，5公里内有三甲医院（综合医院）3家及其他各级各类医疗卫生机构10余家；与附属医院、区医院、银川市人民医院、解放军第942医院、宁夏颐阳医院签署绿色通道；各医疗卫生机构为入住老年人提供疾病诊治、急诊、转诊等就医便利服务；其中解放军第942医院为我机构提供培训、宁夏颐阳医院提供巡诊服务。北安社区卫生服务站长期为我机构提供保健咨询、巡诊查房、疾病诊疗、康复护理等服务并定期开展免费健康体检，及时发现和处置机构内老人的突发病情，不断提升医养结合服务质量，做到“慢病有人管、急病早发现、小病能处理、大病易转诊”，提升了老人及家属的满意度。机构入住房间及公共场所配置智能化麦麦呼叫系统；实时观测房间内长者活动异常；失能长者配备智能胸牌，提高服务质量，及时发现异常进行处置，确保长者安全。中心积极响应周边老年人用餐需求，将其养老机构内的餐厅对外开放，辐射周边北安、云开苑、绿宁苑、景安苑等7个居民小区为60岁以上老年人提供助餐服务。","observationCount":1}},"beds":{"total":{"state":"observed","value":70,"observationCount":1},"dayCare":{"state":"observed","value":0,"observationCount":1},"fullCare":{"state":"observed","value":70,"observationCount":1},"nursing":{"state":"observed","value":70,"observationCount":1}},"feeSummary":[{"code":"04","label":"月总费用","range":{"state":"observed","value":[4080,7580],"observationCount":1},"description":{"state":"observed","value":"床位费差价与房型有关，护理费差价与护理等级有关","observationCount":1}},{"code":"02","label":"床位费用","range":{"state":"observed","value":[1180,2380],"observationCount":1},"description":{"state":"observed","value":"根据长者身体能力及需求进行定位定价","observationCount":1}},{"code":"01","label":"护理费用","range":{"state":"observed","value":[1700,4000],"observationCount":1},"description":{"state":"observed","value":"根据长者需求选择进行定位定价","observationCount":1}},{"code":"03","label":"膳食费用","range":{"state":"observed","value":[1200,1200],"observationCount":1},"description":{"state":"observed","value":"统一定价","observationCount":1}}],"charges":{"state":"observed","value":[{"id":"400ab33808804b209cf035837ed53f3b","name":"床位费","description":"根据长者需求选择进行定位定价","standard":"1180-2380元/月"},{"id":"ff582a75f0af44069f22023309e686a7","name":"护理费","description":"根据长者身体能力及需求进行定位定价","standard":"1700-4000元/月"},{"id":"1702457974cf4436a8956e73607f249b","name":"总费用","description":"床位费差价与房型有关，护理费差价与护理等级有关","standard":"4080-7580元/月"},{"id":"9bf0f4f3033f43aa8f98fb21bbe46537","name":"餐费","description":"统一定价","standard":"1200元/月"}],"observationCount":1},"evaluation":{"state":"observed","text":"暂无平台评价","count":{"state":"observed","value":0,"observationCount":2},"score":{"state":"observed","value":0,"observationCount":2}}},"conflictLabels":[],"detailObservedAtUtc":{"earliest":"2026-11-19T10:48:02.927260+00:00","latest":"2026-11-19T10:49:05.213893+00:00"}}

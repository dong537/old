桥长者照护之家由欧阳街道筹办，委托上海福寿康居家养老康复护理服务社运营管理，位于蒋家桥路15号1甲，建筑面积684平米，核定床位39张，设有二人间、四人间、七人间。主要服务内容包括日常照护、清洁卫生、预防保健、社交娱乐等。机构特色为智慧养老，站内配置远程呼叫系统、智能监控系统、智能巡更打卡系统。并配置休息区、康复区、休闲娱乐等活动空间，人性化设计，全方位一体化服务，通过短期住养和喘息照护相结合的方式，让更多长者感受到家的温暖，提高晚年生活质量。福寿康成立于2011年，引入国外先进护理理念培训体系与服务流程，为社区老、弱、病、残人士提供“互联网+医养结合”的全程服务。","observationCount":1},"service":{"content":{"state":"observed","value":"长者照护之家是为老年人就近提供集中照护服务的社区托养设施，功能介于社区日间照料中心和敬老院、护理院之间，一般采取小区嵌入式设置，并辐射周边社区。","observationCount":1},"team":{"state":"observed","value":"总员工9人, 管理岗位2 人,专业人员1人， 护理员岗位6 人.","observationCount":1},"hours":{"state":"observed","value":"24小时","observationCount":1},"scope":{"state":"observed","value":"长者照护之家是为老年人就近提供集中照护服务的社区托养设施，功能介于社区日间照料中心和敬老院、护理院之间，一般采取小区嵌入式设置，并辐射周边社区。","observationCount":1},"explanation":{"state":"observed","value":"为本街道及周边社区，无重大疾病、无生命垂危、无精神障碍、无传染性疾病的老人提供24小时中短期住养康复服务，是长护险定点机构。","observationCount":1}},"beds":{"total":{"state":"observed","value":39,"observationCount":1},"dayCare":{"state":"observed","value":1,"observationCount":1},"fullCare":{"state":"observed","value":38,"observationCount":1},"nursing":{"state":"observed","value":0,"observationCount":1}},"feeSummary":[{"code":"04","label":"月总费用","range":{"state":"observed","value":[4780,6080],"observationCount":1},"description":{"state":"observed","value":"总费用","observationCount":1}},{"code":"02","label":"床位费用","range":{"state":"observed","value":[2200,2500],"observationCount":1},"description":{"state":"observed","value":"床位费","observationCount":1}},{"code":"01","label":"护理费用","range":{"state":"observed","value":[1500,2500],"observationCount":1},"description":{"state":"observed","value":"护理费","observationCount":1}},{"code":"03","label":"膳食费用","range":{"state":"observed","value":[1080,1080],"observationCount":1},"description":{"state":"observed","value":"早中晚三餐","observationCount":1}}],"charges":{"state":"observed","value":[{"id":"9658004a83fc41af9e4dc70924c5921e","name":"床位费","description":"四人间或七人间","standard":"2200-2500"},{"id":"72b3e3596fd14cc1a4a461027
1},"introduction":{"state":"observed","value":"北京市东城区安定门街道养老服务中心位于安定门街道净土胡同15号，属于核心城区历史文化保护区内，紧邻国子监、雍和宫、钟鼓楼等景点，有良好的市政环境。 该项目成立于2014年，地上三层，地下一层，占地645.7㎡，建筑面积1893.1㎡，备案床位64张，可使用床位50张，全部为护理型床位。分别有单间、双人间和三人间（均内含卫生间），另外设有公共洗浴室、洗衣房、棋牌室、图书室、室内外活动区域（室）等。 分别与鼓楼中医医院、隆福医院等医疗机构建立医养结合合作共建单位，为老人急救开通绿色通道，方便就医。目前提供长短期照料服务（日托-）（机构养老）、老年餐桌服务。","observationCount":1},"service":{"content":{"state":"observed","value":"机构养老","observationCount":1},"team":{"state":"observed","value":"全院21人，管理层人员，厨房餐饮人员，中控室人员、医护人员等构成。","observationCount":1},"hours":{"state":"observed","value":"24小时","observationCount":1},"scope":{"state":"observed","value":"北京市","observationCount":1},"explanation":{"state":"observed","value":"1.社区餐厅：制餐区、配餐区、堂食大厅、开通刷卡、扫码、现金等多种支付方式。 2.老年学堂：定期举办各类课堂培训等。 3.托养服务：设置集中养老服务区、辐射开展居家长期照护服务、开展临时托养服务、开展日间照料服务、配置智慧照护与信息化健康监测管理系统。 4.医养服务：与周边医疗康复护理机构签约合作（联合体成员单位） 5.综合服务：接待咨询办事区、调度监管区、志愿者工作站、康辅器具租售、适老化改造展示。","observationCount":1}},"beds":{"total":{"state":"observed","value":64,"observationCount":1},"dayCare":{"state":"observed","value":0,"observationCount":1},"fullCare":{"state":"observed","value":64,"observationCount":1},"nursing":{"state":"observed","value":64,"observationCount":1}},"feeSummary":[{"code":"04","label":"月总费用","range":{"state":"observed","value":[0,0],"observationCount":4},"description":{"state":"missing","value":null,"observationCount":0}},{"code":"02","label":"床位费用","range":{"state":"missing","value":null,"observationCount":0},"description":{"state":"missing","value":null,"observationCount":0}},{"code":"01","label":"护理费用","range":{"state":"missing","value":null,"observationCount":0},"description":{"state":"missing","value":null,"observationCount":0}},{"code":"03","label":"膳食费用","range":{"state":"missing","value":null,"observationCount":0},"description":{"state":"missing","value":null,"observationCount":0}}],"charges":{"state":"observed","value":[{"id":"f1a81a1a231245529f3e8918e0229cce","name":"机构养老","description":"长期居住养老机构","standard":"6800-8800"}],"observationCount":1},"e
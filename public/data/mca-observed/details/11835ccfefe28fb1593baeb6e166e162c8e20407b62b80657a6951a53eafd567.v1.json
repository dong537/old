te":"missing","source":null,"warning":null},{"key":"evaluationCount","label":"平台评价次数","text":"0 次","state":"observed","source":{"channelLabel":"基本详情","fetchedAtUtc":"2026-11-20T13:06:24.008433+00:00"},"warning":null},{"key":"overallEvaluation","label":"平台综合评价原值","text":"暂无评价（原值为 0）","state":"observed","source":{"channelLabel":"基本详情","fetchedAtUtc":"2026-11-20T13:06:24.008433+00:00"},"warning":null},{"key":"functionPositioningLabel","label":"功能定位原标签","text":"原平台未提供","state":"missing","source":null,"warning":null},{"key":"platformTagsRaw","label":"平台标签原文（资格未核）","text":"民办,城区","state":"observed","source":{"channelLabel":"基本详情","fetchedAtUtc":"2026-11-20T13:06:24.008433+00:00"},"warning":null}],"platformDetail":{"identity":{"facilityType":{"state":"missing","value":null,"observationCount":0},"starCode":{"state":"missing","value":null,"observationCount":0},"functionPositioning":{"state":"missing","value":null,"observationCount":0},"region":{"state":"missing","value":null,"observationCount":0},"address":{"state":"observed","value":"黄冈市黄州区贾家街5号院","observationCount":1}},"tags":{"state":"observed","value":["民办","城区"],"observationCount":1},"subsidyCode":{"state":"observed","value":"1","observationCount":1},"contactName":{"state":"observed","value":"童晓玲","observationCount":1},"contactPhone":{"state":"observed","value":"15629636688","observationCount":1},"pointRaw":{"state":"observed","value":"114.86726,30.44921","observationCount":1},"photoCount":{"state":"observed","value":10,"observationCount":1},"areaSqm":{"state":"observed","value":1500,"observationCount":1},"introduction":{"state":"observed","value":"黄冈市文康养老成立于 2014年，是一所民营养老综合机构，目前在黄冈市中心城区有四家分支机构分别设在龙王山、宝塔、一字门，其中一字门有两家含一家居家养老服务中心，总床位 228 张。 文康养老一体化的服务及设施，最大程度方便住院长者的生活娱乐就医需求，院方同黄冈市各大医院达成协议，开通绿色通道，保障老人及时就医需求，与社区门诊建立医疗合作单位，为方便老人出行或有紧急情况须处理，市内有专车接送。文康一字门居家养老服务活动中心，设有社区食堂和老年活动中心，对社区老人开放，15 分钟养老服务圈，使养老方式更灵活便捷。","observationCount":1},"service":{"content":{"state":"observed","value":"机构养老：院内照护，就医陪诊，出院转运，代购。 居家养老：24小时居家专护，家庭养老床位。 社区养老：日托服务，上门助浴，健康平估。 服务功能：康复护理、老年助餐、家庭支持、生活服务、文化娱乐、日托服务、智慧养老。","observationCount":1},"team":{"state":"observed","value":"黄冈市文康养老服务有限公司的服务团队由多类专业人员组成，确保为老年人提供全面、专业的照护服务。以下是我们服务团队的具体构成及职责描述： 1. 管理团队 院长/主任 ：负责机构整体运营、政策落实及服务质量监督。 行政人员 ：处理日常事务、家属沟通、档案管理及协调各部门工作。 2. 护理团队 护理员 （持证）：负责老人日常生活照料，如协助洗漱、进食、翻身、如厕等。 康复师 ：制定个性化康复计划，指导老人进行运动训练、理疗及术后恢复。 3. 后勤保障团队 营养师/厨师 ：设计营养膳食菜单，满足特殊饮食需求（如低糖、低盐）。 保洁人员 ：维护机构环境卫生，定期消毒公共区域及居室。 维修与安保人员 ：保障设施安全运行，处理紧急情况，24小时值班巡查。","observationCount":1},"hours":{"state":"observed","value":"服务时间：24小时服务","observationCount":1},"scope":{"state":"observed","value":"服务范围：本地区及周边县市","observationCount":1},"explanation":{"state":"observed","value":"为老年人提供全面的生活照料、健康管理、精神慰藉、安全保障等服务。 生活照料：为老年人提供日常生活照料，包括饮食、起居个人卫生清理等服务。 健康管理：为老人提供量血压、测血糖、监护用药等。 精神慰藉：关注老人的精神需求，提供文化娱乐等。 安全保障：确保老年人的人身安全，提供必要的安全设施安全管理服务保障。","observationCount":1}},"beds":{"total":{"state":"observed","value":56,"observationCount":1},"dayCare":{"state":"observed","value":0,"observationCount":1},"fullCare":{"state":"observed","value":56,"observationCount":1},"nursing":{"state":"observed","value":40,"observationCount":1}},"feeSummary":[{"code":"04","label":"月总费用","range":{"state":"observed","value":[1500,3600],"observationCount":1},"description":{"state":"observed","value":"总费用","observationCount":1}},{"code":"02","label":"床位费用","range":{"state":"observed","value":[500,1000],"observationCount":1},"description":{"state":"observed","value":"床位费","observationCount":1}},{"code":"01","label":"护理费用","range":{"state":"observed","value":[400,1800],"observationCount":1},"description":{"state":"observed","value":"护理费","observationCount":1}},{"code":"03","label":"膳食费用","range":{"state":"observed","value":[600,800],"observationCount":1},"description":{"state":"observed","value":"膳食费","observationCount":1}}],"charges":{"state":"observed","value":[{"id":"fe0582ec084a45f8ad3554425780cbb7","name":"自 理","description":"送餐、送水、搞卫生、洗衣服、理发/剃须、指甲/修剪、喂药","standard":"1500~2100"},{"id":"dc43084fbfa74397a8325713bf527bd1","name":"半自理","de